strict-peer-dependencies=true
shamefully-hoist=false

# Private @ventora package registry. Not publicly published — see the "Local development"
# note in README.md. Host and auth token are supplied by the environment; the token itself
# is never committed.
@ventora:registry=https://ventora-package-registry.example.workers.dev/
//ventora-package-registry.example.workers.dev/:_authToken=${VENTORA_REGISTRY_TOKEN}
