# App URL — the React SPA where users log in and sign up
# Defaults to https://app.grantpipe.com if unset
PUBLIC_APP_URL=https://app.grantpipe.com

# PostHog analytics (leave blank to disable)
# These values are threaded into the site bootstrap at build time.
# If omitted, the code falls back to the explicit defaults in packages/ui.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry browser error monitoring (leave blank to disable)
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=development
PUBLIC_SENTRY_RELEASE=

# Microsoft Advertising UET tag ID for Bing Ads conversion tracking
# Falls back to the bundled production tag (343248795) if unset
PUBLIC_BING_UET_ID=
