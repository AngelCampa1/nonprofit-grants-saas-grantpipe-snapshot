---
import "../../styles/global.css"
import { getCollection } from "astro:content"
import { getContentEntrySlug } from "@/lib/content-entry-slug"
import CategoryHub from "@grantpipe/ui/site/hubs/category-hub.astro"
import { siteConfig, shouldShowMobileStickyCta } from "@/config/site"
import { sortByUpdatedAtDesc, mapToContentItems } from "@grantpipe/ui/site/lib/collections"
import { resolveExitLeadMagnetOffer } from "@/lib/lead-magnet-routing"

const leadMagnets = await getCollection("lead-magnets")
const exitLeadMagnet = resolveExitLeadMagnetOffer(siteConfig, leadMagnets, { family: "solution" })
const entries = await getCollection("personas")
const sorted = sortByUpdatedAtDesc(entries)
const items = mapToContentItems(sorted, (e) => `/for/${getContentEntrySlug(e)}`)
const page = {
  data: items,
  currentPage: 1,
  lastPage: 1,
  url: { prev: undefined, next: undefined },
}
const personaRoleGroupDefinitions = [
  {
    title: "Lead the org",
    description: "For leaders who need clear board, budget, and risk views.",
    hrefs: ["/for/executive-directors", "/for/board-treasurers"],
  },
  {
    title: "Raise and track funds",
    description: "For teams that manage grants, gifts, and funder updates.",
    hrefs: ["/for/development-directors", "/for/grants-managers", "/for/grant-writers"],
  },
  {
    title: "Run the work",
    description: "For staff who need clean records and fewer handoffs.",
    hrefs: [
      "/for/finance-operations-staff",
      "/for/operations-managers",
      "/for/program-directors",
    ],
  },
]
const personaItemsByHref = new Map(items.map((item) => [item.href, item]))
const personaRoleGroups = personaRoleGroupDefinitions
  .map((group) => ({
    ...group,
    items: group.hrefs
      .map((href) => personaItemsByHref.get(href))
      .filter((item): item is (typeof items)[number] => item !== undefined),
  }))
  .filter((group) => group.items.length > 0)
---

<CategoryHub
  config={siteConfig}
  title="GrantPipe by role"
  description="Persona-specific views of GrantPipe for executive directors, development directors, grant managers, and operations leads."
  variant="editorial"
  items={items}
  page={page}
  basePath="/for"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "For", href: "/for" },
  ]}
  emptyStateHeading="No persona pages match this view yet."
  emptyStateBody="See the product overview for how GrantPipe maps to development, finance, and grant management roles."
  showStickyMobileCta={shouldShowMobileStickyCta(Astro.url.pathname)}
  leadMagnet={exitLeadMagnet}
  renderListing={false}
>
  <section slot="intro" class="mb-10 space-y-10">
    <section aria-label="Role paths">
      <div class="mb-5 max-w-2xl">
        <p class="gp-kicker--accent">Role paths</p>
        <h2 class="mt-3 font-heading text-[length:var(--text-heading)] font-bold text-brand-text">
          Pick the job you need to support.
        </h2>
        <p class="mt-3 text-brand-muted">
          Start with the person who feels the pain. Then move to the product view.
        </p>
      </div>
      <div data-persona-role-grid class="grid gap-4 lg:grid-cols-3">
        {personaRoleGroups.map((group) => (
          <article class="gp-card-base h-full rounded-lg p-5">
            <h3 class="font-heading text-[length:var(--text-subheading)] font-bold text-brand-text">
              {group.title}
            </h3>
            <p class="mt-3 text-[length:var(--text-body)] leading-7 text-brand-muted">
              {group.description}
            </p>
            <div class="mt-5 grid gap-2">
              {group.items.map((item) => (
                <a
                  href={item.href}
                  class="rounded-full px-3 py-2 text-[length:var(--text-caption)] font-medium text-brand-text no-underline transition-colors hover:bg-[var(--gp-paper-2)] hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
                >
                  {item.title}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  </section>

  <section
    slot="cta"
    data-persona-next-step
    class="mt-10 rounded-xl border border-[var(--gp-ink-100)] bg-[var(--gp-paper-2)] p-6 sm:p-8"
  >
    <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
      <div class="max-w-2xl">
        <p class="gp-kicker--accent">Next step</p>
        <h2 class="mt-3 font-heading text-[length:var(--text-heading)] font-bold text-brand-text">
          See the shared system behind each role.
        </h2>
        <p class="mt-3 text-brand-muted">
          GrantPipe gives each role a focused view of the same grant, fund, and report data.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/product/"
          class="inline-flex rounded-full bg-brand-primary px-5 py-3 text-[length:var(--text-caption)] font-bold text-white no-underline shadow-sm transition hover:bg-brand-primary-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
        >
          See product tour
        </a>
        <a
          href="/pricing/"
          class="inline-flex rounded-full border border-[var(--gp-ink-200)] bg-white px-5 py-3 text-[length:var(--text-caption)] font-bold text-brand-text no-underline transition hover:border-[var(--gp-emerald-300)] hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
        >
          See pricing
        </a>
      </div>
    </div>
  </section>
</CategoryHub>
