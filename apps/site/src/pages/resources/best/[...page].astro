---
import "../../../styles/global.css"
import { getCollection } from "astro:content"
import { getContentEntrySlug } from "@/lib/content-entry-slug"
import CategoryHub from "@grantpipe/ui/site/hubs/category-hub.astro"
import PublicSignupCta from "@grantpipe/ui/site/components/public-signup-cta"
import Button from "@/components/ui/button.astro"
import { siteConfig, shouldShowMobileStickyCta } from "@/config/site"
import { hubFaqs } from "@/config/hub-faqs"
import { sortByUpdatedAtDesc } from "@grantpipe/ui/site/lib/collections"
import { resolveExitLeadMagnetOffer } from "@/lib/lead-magnet-routing"
import { buildListicleHubModel } from "@/lib/listicle-hub"

export async function getStaticPaths({ paginate }: import("astro").GetStaticPathsOptions) {
  const entries = await getCollection("listicles")
  const sorted = sortByUpdatedAtDesc(entries)
  const listicleHub = buildListicleHubModel(sorted, (entry) => `/resources/best/${getContentEntrySlug(entry)}`)
  return paginate(listicleHub.items, { pageSize: 12 })
}

const { page } = Astro.props
const listicleEntries = await getCollection("listicles")
const leadMagnets = await getCollection("lead-magnets")
const listicleHub = buildListicleHubModel(sortByUpdatedAtDesc(listicleEntries), (entry) => `/resources/best/${getContentEntrySlug(entry)}`)
const exitLeadMagnet = resolveExitLeadMagnetOffer(siteConfig, leadMagnets, { family: "listicle" })
---

<CategoryHub
  config={siteConfig}
  title="Software Roundups"
  description="Ranked lists of nonprofit software - tested, compared, and reviewed for development directors."
  leadMagnet={exitLeadMagnet}
  items={page.data}
  page={page}
  basePath="/resources/best"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Resources", href: "/resources" },
    { label: "Software Roundups", href: "/resources/best" },
  ]}
  faqs={hubFaqs["/resources/best"]}
  emptyStateHeading="No software roundups match this page yet."
  emptyStateBody="Browse the full resources hub for guides, comparisons, and pricing breakdowns."
  showStickyMobileCta={shouldShowMobileStickyCta("/resources/best")}
>
  <section slot="intro" class="mb-10 space-y-10">
    <section class="gp-resource-decision-panel editorial-panel p-6" aria-label="Roundup start">
      <p class="gp-proof-label">Decision path</p>
      <h2 class="gp-link-card-title">Pick the right shortlist.</h2>
      <p class="gp-link-card-copy mt-3">
        Use roundups when the tool list is too wide. Compare by job. Then check
        whether GrantPipe fits the way your team works.
      </p>
    </section>

    <section aria-label="Software roundup topics">
      <div class="mb-5 max-w-2xl">
        <p class="gp-kicker--accent">Topic paths</p>
        <h2 class="mt-3 font-heading text-[length:var(--text-heading)] font-bold text-brand-text">
          Pick a roundup by topic.
        </h2>
        <p class="mt-3 text-brand-muted">
          Start with the software area you need to compare. Each topic shows a short list.
        </p>
      </div>
      <div data-listicle-topic-grid class="grid gap-4 md:grid-cols-2">
        {listicleHub.topicSummaries.map((topic) => (
          <article class="gp-card-base h-full rounded-lg p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="gp-proof-label">Topic</p>
                <h3 class="mt-2 font-heading text-[length:var(--text-subheading)] font-bold text-brand-text">
                  {topic.title}
                </h3>
              </div>
              <span class="rounded-full border border-[var(--gp-ink-200)] px-3 py-1 text-[length:var(--text-caption)] font-medium text-brand-muted">
                {topic.totalCount} {topic.totalCount === 1 ? "roundup" : "roundups"}
              </span>
            </div>
            <p class="mt-3 text-[length:var(--text-body)] leading-7 text-brand-muted">
              {topic.description}
            </p>
            <div class="mt-5 grid gap-2">
              {topic.previewItems.map((item) => (
                <a
                  href={item.href}
                  class="rounded-full px-3 py-2 text-[length:var(--text-caption)] font-medium text-brand-text no-underline transition-colors hover:bg-[var(--gp-paper-2)] hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
                >
                  {item.title}
                </a>
              ))}
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              <a class="gp-filter-chip" href={`${topic.href}/`}>See topic path</a>
              {topic.overflowCount > 0 && (
                <span class="gp-filter-chip" aria-label={`${topic.overflowCount} more roundups in this topic`}>
                  {topic.overflowCount} more
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section aria-label="Software roundup stages">
      <div class="mb-5 max-w-2xl">
        <p class="gp-kicker--accent">Next step</p>
        <h2 class="mt-3 font-heading text-[length:var(--text-heading)] font-bold text-brand-text">
          Pick by buying stage.
        </h2>
        <p class="mt-3 text-brand-muted">
          Use this if you know what decision comes next.
        </p>
      </div>
      <div data-listicle-stage-grid class="grid gap-4 lg:grid-cols-3">
        {listicleHub.stageSections.map((section) => (
          <article class="gp-card-base h-full rounded-lg p-5">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
              <span class="rounded-full border border-[var(--gp-ink-200)] px-3 py-1 text-[length:var(--text-caption)] font-medium text-brand-primary">
                {section.label}
              </span>
              <span class="text-[length:var(--text-caption)] text-brand-muted">
                {section.totalCount} {section.totalCount === 1 ? "roundup" : "roundups"}
              </span>
            </div>
            <h3 class="font-heading text-[length:var(--text-subheading)] font-bold text-brand-text">
              {section.heading}
            </h3>
            <p class="mt-3 text-[length:var(--text-body)] leading-7 text-brand-muted">
              {section.description}
            </p>
            <div class="mt-5 grid gap-3">
              {section.items.map((item) => (
                <a
                  href={item.href}
                  class="rounded-lg border border-[var(--gp-ink-100)] bg-[var(--gp-paper)] p-3 no-underline transition-[border-color,background-color,color] hover:border-[var(--gp-emerald-200)] hover:bg-[var(--gp-paper-2)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
                >
                  <span class="block font-heading text-[length:var(--text-body)] font-bold leading-snug text-brand-text">
                    {item.title}
                  </span>
                  {item.metadata?.category && (
                    <span class="mt-1 block text-[length:var(--text-caption)] text-brand-muted">
                      {item.metadata.category}
                    </span>
                  )}
                </a>
              ))}
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              <a class="gp-filter-chip" href={`${section.nextStepHref}/`}>
                {section.nextStepLabel}
              </a>
              {section.overflowCount > 0 && (
                <span class="gp-filter-chip" aria-label={`${section.overflowCount} more roundups in this stage`}>
                  {section.overflowCount} more
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </section>

  <section slot="cta" class="editorial-panel gp-shared-cta-shell" id="signup">
    <h2>Start a 1-month free trial after the shortlist is clear.</h2>
    <p>
      Put GrantPipe next to your current tools and see whether one workflow can replace the handoffs.
    </p>
    <div class="gp-shared-cta-actions">
      <PublicSignupCta
        client:load
        sourcePage="/resources/best"
        buttonText={siteConfig.funnel.bofu.ctaText}
      />
      <Button variant="secondary" size="md" href="/pricing/">See pricing and fit</Button>
    </div>
  </section>
</CategoryHub>
