---
import "../../../styles/global.css";
import { getCollection } from "astro:content";
import CategoryHub from "@grantpipe/ui/site/hubs/category-hub.astro";
import Button from "@/components/ui/button.astro";
import { siteConfig, shouldShowMobileStickyCta } from "@/config/site";
import { buildResourceHubItems } from "@/lib/resource-hubs";
import { resolveExitLeadMagnetOffer } from "@/lib/lead-magnet-routing";
import PathwaySections from "@/components/site/pathway-sections.astro";
import { buildBenchmarkPathSections } from "@/lib/hub-path-sections";

const [
  alternatives,
  comparisons,
  pricingBreakdowns,
  listicles,
  guides,
  statePages,
  cityPages,
  verticalPages,
  leadMagnets,
  personas,
  workflows,
  glossary,
  features,
  integrations,
  faqHubs,
  benchmarks,
] = await Promise.all([
  getCollection("alternatives"),
  getCollection("comparisons"),
  getCollection("pricing-breakdowns"),
  getCollection("listicles"),
  getCollection("guides"),
  getCollection("state-pages"),
  getCollection("city-pages"),
  getCollection("vertical-pages"),
  getCollection("lead-magnets"),
  getCollection("personas"),
  getCollection("workflows"),
  getCollection("glossary"),
  getCollection("features"),
  getCollection("integrations"),
  getCollection("faq-hubs"),
  getCollection("benchmarks"),
]);

const exitLeadMagnet = resolveExitLeadMagnetOffer(siteConfig, leadMagnets, { family: "guide" });
const items =
  buildResourceHubItems({
    alternatives,
    comparisons,
    pricingBreakdowns,
    listicles,
    guides,
    statePages,
    cityPages,
    verticalPages,
    leadMagnets,
    personas,
    workflows,
    glossary,
    features,
    integrations,
    faqHubs,
    benchmarks,
  }).get("/resources/benchmarks") ?? [];
const benchmarkPathSections = buildBenchmarkPathSections(items);
const page = {
  data: items,
  currentPage: 1,
  lastPage: 1,
  url: { prev: undefined, next: undefined },
};
---

<CategoryHub
  config={siteConfig}
  title="Benchmarks"
  description="Benchmark pages for nonprofit grant compliance, donor retention, audit exposure, accounting, and sector operating context."
  variant="editorial"
  items={items}
  page={page}
  basePath="/resources/benchmarks"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Resources", href: "/resources" },
    { label: "Benchmarks", href: "/resources/benchmarks" },
  ]}
  emptyStateHeading="No benchmark pages match this view yet."
  emptyStateBody="Browse the resources hub for guides, FAQ hubs, and reference pages on the same topics."
  showStickyMobileCta={shouldShowMobileStickyCta("/resources/benchmarks")}
  leadMagnet={exitLeadMagnet}
  renderListing={false}
>
  <div slot="intro" class="space-y-8">
    <section class="gp-resource-decision-panel editorial-panel p-6">
      <p class="gp-proof-label">Decision path</p>
      <h2 class="gp-link-card-title">Use benchmarks when risk needs numbers.</h2>
      <p class="gp-link-card-copy mt-3">
        Pick the risk first. Then compare it with the closest benchmark.
      </p>
    </section>
    <PathwaySections sections={benchmarkPathSections} ariaLabel="Benchmark paths" />
  </div>

  <section slot="cta" class="editorial-panel gp-shared-cta-shell" id="signup">
    <h2>Start a 1-month free trial when the benchmark points to a process change.</h2>
    <p>
      Compare the numbers against a live GrantPipe workflow for awards, restrictions, deadlines,
      and review-ready evidence.
    </p>
    <div class="gp-shared-cta-actions">
      <Button variant="primary" size="lg" href={siteConfig.funnel.bofu.ctaTarget}>
        {siteConfig.funnel.bofu.ctaText}
      </Button>
      <Button variant="secondary" size="md" href="/pricing/">See pricing and fit</Button>
    </div>
  </section>
</CategoryHub>
