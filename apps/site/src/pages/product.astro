<style>
  /*
   * Closing CTA band override.
   * `.gp-mkt-btn.ghost` is dark-ink-on-transparent by default, which reads as
   * near-invisible on the `.gp-section--emerald` dark fill. This scoped
   * override keeps the same ghost/pill shape and hover behavior but swaps to
   * a white-on-transparent treatment for the one CTA that lives on the
   * emerald band.
   */
  .gp-mkt-btn--on-emerald {
    border-color: color-mix(in srgb, #ffffff 45%, transparent);
    color: #ffffff;
  }

  .gp-mkt-btn--on-emerald:hover {
    background: color-mix(in srgb, #ffffff 12%, transparent);
    border-color: color-mix(in srgb, #ffffff 65%, transparent);
  }

  .gp-mkt-btn--on-emerald:active {
    background: color-mix(in srgb, #ffffff 18%, transparent);
  }

  /*
   * OS-modules sticky walkthrough.
   * - Desktop/JS-on: the module rail becomes `position: sticky` and each
   *   copy block's IntersectionObserver entry highlights its matching
   *   modules in the rail as it scrolls through the viewport center.
   * - Reduced-motion / no-JS / narrow viewports: the rail is static and
   *   stacks below the copy. All copy and all module names/benefits are
   *   present in the markup either way (see the full grid rendered right
   *   after the walkthrough), so nothing here is required for readability.
   */
  .gp-os-walkthrough {
    display: grid;
    gap: 1.5rem;
  }

  .gp-os-walkthrough__copy {
    display: grid;
    gap: 1.25rem;
  }

  .gp-os-walkthrough__step {
    padding: 1.25rem;
    border-radius: var(--card-radius, 1rem);
    border: 1px solid color-mix(in srgb, var(--color-neutral-300) 44%, transparent);
    background: color-mix(in srgb, var(--surface-primary) 92%, var(--surface-secondary));
  }

  .gp-os-walkthrough__visual-rail {
    /* Reserve height up front so activating sticky/JS state never shifts layout (CLS-safe). */
    min-height: 1px;
  }

  .gp-os-walkthrough__visual {
    padding: 1.25rem;
    border-radius: var(--card-radius, 1rem);
    border: 1px solid color-mix(in srgb, var(--color-primary-300) 40%, transparent);
    background: color-mix(in srgb, var(--color-primary-50) 46%, var(--surface-primary));
  }

  .gp-os-walkthrough__module {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem;
    border-radius: 0.75rem;
    opacity: 0.55;
    transition:
      opacity var(--transition-base, 240ms ease),
      background-color var(--transition-base, 240ms ease),
      transform var(--transition-base, 240ms ease);
  }

  .gp-os-walkthrough__module[data-os-active="true"] {
    opacity: 1;
    background: color-mix(in srgb, var(--surface-primary) 88%, transparent);
    transform: translateX(0.15rem);
  }

  .gp-os-walkthrough__dot {
    width: 1.75rem;
    height: 1.75rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* Sticky visual only on viewports wide enough for the two-column layout,
     and only when the visitor allows motion. Everywhere else this is a
     normal stacked, non-sticky block. */
  @media (min-width: 1024px) {
    .gp-os-walkthrough {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.85fr);
      align-items: start;
    }

    .gp-os-walkthrough__visual-rail {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gp-os-walkthrough__module {
      transition: none;
    }
  }
</style>

<script>
  // Highlights the OS modules in the sticky rail that match whichever
  // walkthrough copy block is currently in view. Progressive enhancement
  // only: every module name/benefit already renders as static text in both
  // the walkthrough copy blocks and the full grid below, so this script
  // never gates content — it only adjusts which rail rows look emphasized.
  (function () {
    var activeObservers: IntersectionObserver[] = [];

    function disconnectObservers() {
      activeObservers.forEach(function (observer) {
        observer.disconnect();
      });
      activeObservers = [];
    }

    function initOsWalkthrough() {
      disconnectObservers();

      var prefersReducedMotion =
        typeof window.matchMedia === "function" &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (prefersReducedMotion || typeof IntersectionObserver === "undefined") {
        return;
      }

      var walkthroughs = Array.prototype.slice.call(
        document.querySelectorAll("[data-os-walkthrough]:not([data-os-walkthrough-bound])"),
      );

      walkthroughs.forEach(function (walkthrough) {
        walkthrough.setAttribute("data-os-walkthrough-bound", "true");

        var stepEls = Array.prototype.slice.call(
          walkthrough.querySelectorAll("[data-os-step]"),
        );
        var moduleEls = Array.prototype.slice.call(
          walkthrough.querySelectorAll("[data-os-module]"),
        );

        if (!stepEls.length || !moduleEls.length) {
          return;
        }

        // Module indices (into the full osModules array) that each step
        // highlights, keyed by the step's own index. Derived at runtime from
        // each step block's rendered module names so this script never needs
        // to duplicate the server-rendered grouping data.
        var stepModuleIndexes = stepEls.map(function (stepEl) {
          var moduleNames = Array.prototype.slice
            .call(stepEl.querySelectorAll("span.font-semibold"))
            .map(function (el) {
              return el.textContent ? el.textContent.trim() : "";
            });

          return moduleEls
            .filter(function (moduleEl) {
              var label = moduleEl.querySelector("span:last-child");
              var text = label && label.textContent ? label.textContent.trim() : "";
              return moduleNames.indexOf(text) !== -1;
            })
            .map(function (moduleEl) {
              return moduleEl.getAttribute("data-os-module");
            });
        });

        function setActiveStep(stepIndex: number) {
          var activeModuleIndexes = stepModuleIndexes[stepIndex] || [];
          moduleEls.forEach(function (moduleEl) {
            var isActive = activeModuleIndexes.indexOf(moduleEl.getAttribute("data-os-module")) !== -1;
            if (isActive) {
              moduleEl.setAttribute("data-os-active", "true");
            } else {
              moduleEl.removeAttribute("data-os-active");
            }
          });
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) {
                return;
              }
              var stepIndex = Number(entry.target.getAttribute("data-os-step"));
              if (!Number.isNaN(stepIndex)) {
                setActiveStep(stepIndex);
              }
            });
          },
          { rootMargin: "-40% 0px -40% 0px", threshold: 0 },
        );
        activeObservers.push(observer);

        stepEls.forEach(function (stepEl) {
          observer.observe(stepEl);
        });

        // Start with the first step highlighted so the rail isn't fully dim
        // before any step has crossed the observer's viewport-center band.
        setActiveStep(0);
      });
    }

    initOsWalkthrough();
    document.addEventListener("astro:page-load", initOsWalkthrough);
    document.addEventListener("astro:before-swap", disconnectObservers);
  })();
</script>
