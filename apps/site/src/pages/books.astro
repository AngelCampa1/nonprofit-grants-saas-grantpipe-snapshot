---
import "../styles/global.css"
import BaseLayout from "@grantpipe/ui/site/layouts/base-layout.astro"
import SiteHeader from "@grantpipe/ui/site/components/site-header.astro"
import SiteFooter from "@grantpipe/ui/site/components/site-footer.astro"
import Button from "@/components/ui/button.astro"
import Card from "@/components/ui/card.astro"
import { grantPipeTrialCopy, siteConfig, getSignupCtaTarget, shouldShowMobileStickyCta } from "@/config/site"
import { getAppLoginUrl } from "@/lib/app-url"
import { ensureTrailingSlash } from "@grantpipe/ui/site/lib/meta"
import { ExitIntentPopup } from "@grantpipe/ui/site/components/exit-intent-popup"
import { resolveExitPopupProps } from "@grantpipe/ui/site/lib/exit-popup-props"
import { getPublicApiBaseUrl } from "@grantpipe/ui/site/lib/public-api-url"
import { getCollection } from "astro:content"
import { resolveExitLeadMagnetOffer } from "@/lib/lead-magnet-routing"
import { getPricingPlan, getPlanDisplayPrice } from "../../../../packages/shared/src/pricing"

const auditReadyPlan = getPricingPlan("audit_ready")
const auditReadyMonthlyPrice = getPlanDisplayPrice("audit_ready", "monthly")

const canonicalUrl = ensureTrailingSlash(`https://${siteConfig.domain}/books`)
const leadMagnets = await getCollection("lead-magnets")
const exitLeadMagnet = resolveExitLeadMagnetOffer(siteConfig, leadMagnets, { family: "solution" })
const exitPopupProps = siteConfig.exitPopup?.enabled !== false ? resolveExitPopupProps(siteConfig) : undefined
const publicApiUrl = getPublicApiBaseUrl()
const signupHref = getSignupCtaTarget({ plan: "audit_ready" })

const coaRows = [
  { code: "1010", name: "Cash - Operating", type: "Asset" },
  { code: "1020", name: "Cash - Restricted", type: "Asset" },
  { code: "1200", name: "Accounts Receivable - Grants", type: "Asset" },
  { code: "1500", name: "Prepaid Expenses", type: "Asset" },
  { code: "2000", name: "Accounts Payable", type: "Liability" },
  { code: "2100", name: "Accrued Liabilities", type: "Liability" },
  { code: "3000", name: "Net Assets Without Donor Restrictions", type: "Net Assets" },
  { code: "3100", name: "Net Assets Without Restrictions - Released", type: "Net Assets" },
  { code: "3200", name: "Net Assets With Donor Restrictions - Released", type: "Net Assets" },
  { code: "3500", name: "Net Assets With Donor Restrictions", type: "Net Assets" },
  { code: "4000", name: "Contributions - Unrestricted", type: "Revenue" },
  { code: "4010", name: "Contributions - Restricted", type: "Revenue" },
  { code: "4100", name: "Government Grant Revenue", type: "Revenue" },
  { code: "5000", name: "Program Expense", type: "Expense" },
  { code: "5100", name: "Management & General Expense", type: "Expense" },
  { code: "5200", name: "Fundraising Expense", type: "Expense" },
]

const faqs = [
  {
    q: "Does QuickBooks stay?",
    a: "GrantPipe Books has native accounting records. It does not sync with QuickBooks right now. Payroll and bill pay stay in the tools you already use.",
  },
  {
    q: "Can I import my existing chart of accounts?",
    a: "Yes. You can upload a CSV of your current COA and map account codes to the GrantPipe account types. The nonprofit seed COA is a starting point, not a requirement.",
  },
  {
    q: "What about my CPA?",
    a: "Your CPA can pull reports any time. GrantPipe Books exports the trial balance as a CSV file. It exports the three FASB statements too. Your auditor can check them on their own.",
  },
  {
    q: "Is this audit-ready?",
    a: "Every journal entry has a time stamp. Each entry links to its source: a donation, an expense, or a manual entry. No one can edit or delete an entry. A fix posts as a new reversing entry. The original stays in the ledger. That is the audit trail.",
  },
  {
    q: "Does GrantPipe Books handle payroll?",
    a: "No. Payroll is out of scope for v1. Payroll journal entries can be entered manually as expense entries. We will add payroll provider integrations in a later phase.",
  },
  {
    q: "What happens to my existing donation and expense history when I enable Books?",
    a: "The opening-balance seeder walks you through a dry run first. It shows you how many donations and expenses will be posted, and generates estimated journal entries for review. You confirm before any entries are written.",
  },
]

type AccountType = (typeof coaRows)[number]["type"]
const accountBadgeClass: Record<AccountType, string> = {
  Asset: "gp-books-coa-badge gp-books-coa-badge--asset",
  Liability: "gp-books-coa-badge gp-books-coa-badge--liability",
  "Net Assets": "gp-books-coa-badge gp-books-coa-badge--neutral",
  Revenue: "gp-books-coa-badge gp-books-coa-badge--revenue",
  Expense: "gp-books-coa-badge gp-books-coa-badge--expense",
}

const reconcileSteps = [
  {
    title: "Import",
    body: "Upload a CSV or OFX file from your bank. GrantPipe parses debit/credit conventions automatically and deduplicates against prior imports.",
  },
  {
    title: "Match",
    body: "Each bank transaction shows as unmatched, matched, or ignored. Match a transaction to an existing journal line, or create a new manual entry directly from the unmatched view.",
  },
  {
    title: "Reconcile",
    body: "Enter the statement ending balance. GrantPipe checks that cleared transactions equal the GL cash balance. When it balances, lock the reconciliation. Matched entries cannot be edited without an admin override.",
  },
]

const closeItems = [
  { label: "Bank accounts reconciled", done: true },
  { label: "Unapplied bank transactions", done: true, note: "0 remaining" },
  { label: "Adjusting entries reviewed", done: false, note: "2 pending" },
  { label: "Recurring templates processed", done: true, note: "3 of 3 run" },
]

const auditPoints = [
  {
    label: "Source linking",
    body: "Every auto-posted JE is linked to the donation or expense record that triggered it. One click from the journal to the source.",
  },
  {
    label: "Activity log",
    body: "Every create, update, reverse, or close event is logged with a before/after diff, user ID, and timestamp. The log is append-only.",
  },
  {
    label: "Tamper-evident reversals",
    body: "Journal entries cannot be deleted. Corrections use a reversal: a new JE that offsets the original. The original remains in the ledger.",
  },
  {
    label: "Reconciliation locks",
    body: "Matched entries are locked after bank reconciliation is completed. Editing a locked entry requires admin override with a stated reason.",
  },
]

const sfpRows = [
  { label: "Cash and cash equivalents", without: 182400, with: 96500 },
  { label: "Grants receivable", without: 41200, with: 68900 },
  { label: "Prepaid expenses", without: 8100, with: 0 },
]
const sfpLiabilities = [
  { label: "Accounts payable", without: 22600, with: 0 },
  { label: "Accrued liabilities", without: 13750, with: 0 },
]
const sfpAssetsWithout = sfpRows.reduce((sum, row) => sum + row.without, 0)
const sfpAssetsWith = sfpRows.reduce((sum, row) => sum + row.with, 0)
const sfpLiabilitiesWithout = sfpLiabilities.reduce((sum, row) => sum + row.without, 0)
const sfpNetAssetsWithout = sfpAssetsWithout - sfpLiabilitiesWithout
const sfpNetAssetsWith = sfpAssetsWith
const sfpTotalAssets = sfpAssetsWithout + sfpAssetsWith
const sfpTotalLiabilities = sfpLiabilitiesWithout
const sfpTotalNetAssets = sfpNetAssetsWithout + sfpNetAssetsWith
const formatUsd = (cents: number) => `$${cents.toLocaleString("en-US")}`

const coaTree = [
  {
    code: "1000",
    name: "Assets",
    children: [
      { code: "1010", name: "Cash - Operating" },
      { code: "1020", name: "Cash - Restricted" },
      { code: "1200", name: "Grants Receivable" },
    ],
  },
  {
    code: "3000",
    name: "Net Assets",
    children: [
      { code: "3000", name: "Without Donor Restrictions" },
      { code: "3500", name: "With Donor Restrictions" },
    ],
  },
  {
    code: "4000",
    name: "Revenue",
    children: [
      { code: "4010", name: "Contributions - Restricted" },
      { code: "4100", name: "Government Grant Revenue" },
    ],
  },
]

const restrictedRollforward = [
  { label: "Beginning restricted balance", amount: 214000, kind: "start" },
  { label: "Youth STEM renewal (award)", amount: 125000, kind: "in" },
  { label: "Food access expansion (award)", amount: 84200, kind: "in" },
  { label: "Released to operations (program spend)", amount: -96700, kind: "out" },
  { label: "Ending restricted balance", amount: 326500, kind: "end" },
]

const auditTrailEvents = [
  { time: "9:14 AM", label: "Donation posted", detail: "JE-1042 - Food access expansion, $4,200 restricted" },
  { time: "9:14 AM", label: "Fund tagged", detail: "Linked to grant record GR-2091 automatically" },
  { time: "2:37 PM", label: "Correction filed", detail: "JE-1042-R reverses original; both entries remain visible" },
  { time: "2:38 PM", label: "Reconciliation locked", detail: "Bank match confirmed; entry now requires admin override to edit" },
]

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonicalUrl,
      name: "GrantPipe Books: Fund Accounting for Nonprofits",
      description:
        "GrantPipe Books adds FASB ASC 958 double-entry fund accounting to the GrantPipe compliance-first grant management system. The pricing page shows where Books is included.",
      url: canonicalUrl,
      inLanguage: "en-US",
      publisher: {
        "@type": "Organization",
        name: siteConfig.name,
        url: `https://${siteConfig.domain}`,
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.a,
        },
      })),
    },
  ],
}
---

<BaseLayout
  title="GrantPipe Books: Fund Accounting Built for Nonprofits"
  description="FASB ASC 958 double-entry fund accounting built into GrantPipe. One system for donors, grants, restricted funds, and financial statements. Plan details on the pricing page."
  canonicalUrl={canonicalUrl}
  siteName={siteConfig.name}
  ogType="website"
  twitterSite={siteConfig.social?.twitterHandle}
  theme={siteConfig.theme}
  fonts={siteConfig.theme.fonts}
  themeColor={siteConfig.theme.primary}
  appleTouchIcon={siteConfig.appleTouchIcon}
  showStickyMobileCta={shouldShowMobileStickyCta("/books")}
  stickyCtaText={siteConfig.funnel.bofu.ctaText}
  stickyCtaTarget={getSignupCtaTarget()}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <SiteHeader
    slot="header"
    siteName={siteConfig.name}
    navItems={siteConfig.nav?.items}
    ctaText={siteConfig.funnel.bofu.ctaText}
    ctaHref={getSignupCtaTarget()}
    loginHref={getAppLoginUrl()}
    logoLight={siteConfig.logo?.light}
  >
  </SiteHeader>

  <section class="gp-section" data-section="hero">
      <div class="gp-wrap gp-books-hero">
        <div class="gp-books-hero__lede scroll-in">
          <p class="gp-eyebrow-pill">GrantPipe Books</p>
          <h1>Fund accounting inside GrantPipe. Restricted money stays tied to each record.</h1>
          <p class="gp-books-hero__sub">
            GrantPipe spans eight modules. Books is the fund-accounting module. It ties restricted
            money to each donation, grant, expense, release, and proof trail. QuickBooks stays as
            the accounting system.
          </p>
          <div class="gp-hero-actions">
            <Button
              href={signupHref}
              data-ph-capture-attribute-source="books-hero"
            >
              Start {auditReadyPlan.name}: {auditReadyMonthlyPrice}
            </Button>
            <Button href="/pricing/" variant="secondary">Review all plans</Button>
          </div>
          <p class="gp-books-hero__note">{grantPipeTrialCopy}</p>
        </div>

        <aside class="gp-books-hero__aside" aria-label="What finance teams get">
          <Card variant="feature">
            <p class="gp-proof-label">What finance teams get</p>
            <div class="gp-books-hero__aside-items">
              <div>
                <p class="gp-books-aside-eyebrow">Statement output</p>
                <p class="gp-books-aside-title">
                  Financial position, activities, and functional expenses from one dataset.
                </p>
              </div>
              <div>
                <p class="gp-books-aside-eyebrow">Migration path</p>
                <p class="gp-books-aside-title">
                  Seed opening balances, review the dry run, then turn on posting.
                </p>
              </div>
            </div>
          </Card>

          <Card>
            <p class="gp-proof-label">Premium plan fit</p>
            <p class="gp-books-aside-title">
              Good fit if you want accounting in the same product as fundraising and grant tracking.
            </p>
            <p class="gp-books-aside-body">
              Books is for teams that are done moving donor records, class tags, and exports between
              separate systems.
            </p>
            <Button href={signupHref} variant="secondary" size="sm" class="gp-books-aside-cta">
              Start the {auditReadyPlan.name} trial
            </Button>
          </Card>
        </aside>
      </div>
    </section>

    <section class="gp-section alt" data-section="auto-posting">
      <div class="gp-wrap">
        <div class="gp-section-head center scroll-in">
          <p class="gp-eyebrow-pill">The wedge</p>
          <h2>QuickBooks does not know about your restricted funds. GrantPipe does.</h2>
          <p>
            QuickBooks records the accounting entry. GrantPipe keeps the donor, grant, restriction,
            and proof record beside it. Finance and fundraising can check the story behind the
            number.
          </p>
        </div>

        <div class="gp-books-compare-grid">
          <Card>
            <p class="gp-books-compare__label">Without GrantPipe Books</p>
            <h3 class="gp-books-compare__title">Four manual steps per donation</h3>
            <ol class="gp-books-compare__list">
              <li><span class="gp-books-compare__num">1.</span>Record donation in your CRM or spreadsheet</li>
              <li><span class="gp-books-compare__num">2.</span>Open QuickBooks and find the accounting entry</li>
              <li><span class="gp-books-compare__num">3.</span>Manually apply a class tag to track the restricted fund</li>
              <li><span class="gp-books-compare__num">4.</span>Hope the tag stays accurate when the record is updated later</li>
            </ol>
          </Card>

          <Card variant="feature">
            <p class="gp-books-compare__label gp-books-compare__label--accent">With GrantPipe Books</p>
            <h3 class="gp-books-compare__title">One entry. Books posts the rest.</h3>
            <ol class="gp-books-compare__list">
              <li><span class="gp-books-compare__num gp-books-compare__num--accent">1.</span>Record donation in GrantPipe (restricted or unrestricted)</li>
              <li><span class="gp-books-compare__num gp-books-compare__num--muted">↳</span>Books posts the entry on its own, tagged to the fund</li>
              <li><span class="gp-books-compare__num gp-books-compare__num--muted">↳</span>Log an expense on that fund and the release entry posts too</li>
              <li><span class="gp-books-compare__num gp-books-compare__num--muted">↳</span>QuickBooks sync is not available right now</li>
            </ol>
          </Card>
        </div>
      </div>
    </section>

    <section class="gp-section" data-section="statements" id="statements">
      <div class="gp-wrap">
        <div class="gp-section-head center scroll-in">
          <p class="gp-eyebrow-pill">Financial statements</p>
          <h2>All three FASB ASC 958 statements, built from live data.</h2>
          <p>
            No manual exports. No spreadsheet formulas. The numbers come from the same GL that
            processes every donation and expense.
          </p>
        </div>

        <div
          class="gp-books-visual gp-books-sfp scroll-in"
          role="img"
          aria-label="Sample Statement of Financial Position showing assets, liabilities, and net assets split between with-donor-restrictions and without-donor-restrictions columns, with total assets equal to total liabilities plus net assets"
        >
          <div class="gp-books-visual__chrome" aria-hidden="true">
            <span></span><span></span><span></span>
            <strong>Statement of Financial Position - Sample data</strong>
          </div>
          <div class="gp-books-sfp__table-wrap" aria-hidden="true">
            <table class="gp-books-sfp__table">
              <thead>
                <tr>
                  <th scope="col"></th>
                  <th scope="col">Without restrictions</th>
                  <th scope="col">With restrictions</th>
                  <th scope="col">Total</th>
                </tr>
              </thead>
              <tbody>
                <tr class="gp-books-sfp__group"><td colspan="4">Assets</td></tr>
                {sfpRows.map((row) => (
                  <tr>
                    <td>{row.label}</td>
                    <td>{formatUsd(row.without)}</td>
                    <td>{formatUsd(row.with)}</td>
                    <td>{formatUsd(row.without + row.with)}</td>
                  </tr>
                ))}
                <tr class="gp-books-sfp__subtotal">
                  <td>Total assets</td>
                  <td>{formatUsd(sfpAssetsWithout)}</td>
                  <td>{formatUsd(sfpAssetsWith)}</td>
                  <td>{formatUsd(sfpTotalAssets)}</td>
                </tr>
                <tr class="gp-books-sfp__group"><td colspan="4">Liabilities</td></tr>
                {sfpLiabilities.map((row) => (
                  <tr>
                    <td>{row.label}</td>
                    <td>{formatUsd(row.without)}</td>
                    <td>{formatUsd(row.with)}</td>
                    <td>{formatUsd(row.without + row.with)}</td>
                  </tr>
                ))}
                <tr class="gp-books-sfp__subtotal">
                  <td>Total liabilities</td>
                  <td>{formatUsd(sfpLiabilitiesWithout)}</td>
                  <td>{formatUsd(0)}</td>
                  <td>{formatUsd(sfpTotalLiabilities)}</td>
                </tr>
                <tr class="gp-books-sfp__subtotal">
                  <td>Net assets</td>
                  <td>{formatUsd(sfpNetAssetsWithout)}</td>
                  <td>{formatUsd(sfpNetAssetsWith)}</td>
                  <td>{formatUsd(sfpTotalNetAssets)}</td>
                </tr>
                <tr class="gp-books-sfp__balance">
                  <td>Total liabilities + net assets</td>
                  <td></td>
                  <td></td>
                  <td>{formatUsd(sfpTotalLiabilities + sfpTotalNetAssets)}</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="gp-books-visual__footnote" aria-hidden="true">
            Assets ({formatUsd(sfpTotalAssets)}) = liabilities + net assets ({formatUsd(sfpTotalLiabilities + sfpTotalNetAssets)}). Illustrative sample data.
          </p>
        </div>

        <div class="gp-books-statements-grid">
          <Card as="article">
            <p class="gp-books-stmt__code">SFP</p>
            <h3 class="gp-books-stmt__title">Statement of Financial Position</h3>
            <p class="gp-books-stmt__body">
              The nonprofit balance sheet. Shows assets, liabilities, and net assets split between
              with-donor-restrictions and without-donor-restrictions at any point in time.
            </p>
            <p class="gp-books-stmt__body">
              GrantPipe validates that assets equal liabilities plus net assets on every generation.
              If the GL is out of balance, the system tells you why.
            </p>
          </Card>
          <Card as="article">
            <p class="gp-books-stmt__code">SOA</p>
            <h3 class="gp-books-stmt__title">Statement of Activities</h3>
            <p class="gp-books-stmt__body">
              Revenue and expenses in three columns: without donor restrictions, with donor
              restrictions, and total. Releases from restriction appear as a positive line in the
              unrestricted column and a corresponding negative line in the restricted column.
            </p>
            <p class="gp-books-stmt__body">
              Shows beginning net assets, change for the period, and ending net assets per
              restriction class.
            </p>
          </Card>
          <Card as="article">
            <p class="gp-books-stmt__code">SFE</p>
            <h3 class="gp-books-stmt__title">Statement of Functional Expenses</h3>
            <p class="gp-books-stmt__body">
              Required by ASU 2016-14 for all nonprofits. Shows expense accounts broken down by
              functional class: Program, Management &amp; General, and Fundraising. Includes a total
              column.
            </p>
            <p class="gp-books-stmt__body">
              The functional class is tagged on each expense record at entry time, so the SFE
              generates directly from the journal without manual allocation.
            </p>
          </Card>
        </div>

        <p class="gp-books-stmt__footnote">
          All three statements export to CSV. Print-formatted PDF output is on the roadmap.
        </p>
      </div>
    </section>

    <section class="gp-section alt" data-section="coa">
      <div class="gp-wrap">
        <div class="gp-section-head center scroll-in">
          <span class="gp-icon-chip gp-icon-chip--primary" aria-hidden="true">$</span>
          <p class="gp-eyebrow-pill">Chart of accounts</p>
          <h2>A nonprofit COA seeded on day one.</h2>
          <p>
            The moment you enable GrantPipe Books, a double-entry chart of accounts pre-built for
            FASB ASC 958 is ready to use. You can customize account names, add sub-accounts, or
            import your own COA from a CSV export.
          </p>
        </div>

        <div
          class="gp-books-visual gp-books-coa-tree scroll-in"
          role="img"
          aria-label="Sample chart of accounts tree showing top-level Assets, Net Assets, and Revenue accounts each expanded into nonprofit-specific sub-accounts"
        >
          <div class="gp-books-visual__chrome" aria-hidden="true">
            <span></span><span></span><span></span>
            <strong>Chart of accounts - Sample data</strong>
          </div>
          <div class="gp-books-coa-tree__body" aria-hidden="true">
            {coaTree.map((group) => (
              <div class="gp-books-coa-tree__group">
                <p class="gp-books-coa-tree__parent">
                  <span class="gp-books-coa-tree__code">{group.code}</span>
                  {group.name}
                </p>
                <ul class="gp-books-coa-tree__children">
                  {group.children.map((child) => (
                    <li>
                      <span class="gp-books-coa-tree__code">{child.code}</span>
                      {child.name}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="gp-books-coa-table-wrap">
          <table class="gp-books-coa-table">
            <thead>
              <tr>
                <th scope="col">Code</th>
                <th scope="col">Account Name</th>
                <th scope="col">Type</th>
              </tr>
            </thead>
            <tbody>
              {coaRows.map((row) => (
                <tr>
                  <td class="gp-books-coa-code">{row.code}</td>
                  <td>{row.name}</td>
                  <td>
                    <span class={accountBadgeClass[row.type as AccountType]}>{row.type}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="gp-books-stmt__footnote">
          Partial list. The full seed COA includes sub-accounts for common program types.
        </p>
      </div>
    </section>

    <section class="gp-section" data-section="bank-reconciliation">
      <div class="gp-wrap">
        <div class="gp-section-head center scroll-in">
          <p class="gp-eyebrow-pill">Bank reconciliation</p>
          <h2>Import, match, reconcile. Three steps. One screen.</h2>
          <p>
            No live bank feed in v1. Upload your bank's CSV or OFX export, then match transactions
            to existing journal entries or create new ones for anything the GL does not yet cover.
          </p>
        </div>

        <div class="gp-books-steps">
          {reconcileSteps.map((step, i) => (
            <div class="gp-books-step">
              <span class="gp-books-step__num" aria-hidden="true">{i + 1}</span>
              <h3 class="gp-books-step__title">{step.title}</h3>
              <p class="gp-books-step__body">{step.body}</p>
            </div>
          ))}
        </div>

        <div
          class="gp-books-visual gp-books-rollforward scroll-in"
          role="img"
          aria-label="Sample restricted fund rollforward showing the beginning restricted balance, two grant awards added, program spend released to operations, and the ending restricted balance"
        >
          <div class="gp-books-visual__chrome" aria-hidden="true">
            <span></span><span></span><span></span>
            <strong>Restricted balance rollforward - Sample data</strong>
          </div>
          <div class="gp-books-rollforward__rows" aria-hidden="true">
            {restrictedRollforward.map((row) => {
              const pct = Math.min(100, Math.round((Math.abs(row.amount) / 326500) * 100)) || 4
              return (
                <div class:list={["gp-books-rollforward__row", `is-${row.kind}`]}>
                  <span class="gp-books-rollforward__label">{row.label}</span>
                  <span class="gp-books-rollforward__bar-track">
                    <i class="gp-books-rollforward__bar" style={`--bar: ${pct}%`}></i>
                  </span>
                  <span class="gp-books-rollforward__amount">
