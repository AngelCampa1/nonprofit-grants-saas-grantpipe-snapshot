---
import "../styles/global.css";
import GrantRecipientCategoryPage from "@/components/grant-recipient-category-page.astro";
import { getGrantCategoryPage } from "@/config/grant-recipient-seo";
import { getVideoForPage } from "@grantpipe/shared";
import VideoEmbed from "@/components/video-embed.astro";
import { videoSchema } from "@/lib/video-schema";

const basePage = getGrantCategoryPage("grant-compliance-software");
const page = {
  ...basePage,
  heroDescription:
    "GrantPipe is the compliance-first grant management system, spanning eight modules. Use this page to evaluate compliance workflows, then read the compliance-first grant management system guide and check pricing for what each plan includes.",
};
const contextualVideo = getVideoForPage("/grant-compliance-software");
---

<GrantRecipientCategoryPage page={page}>
  <Fragment slot="contextual-video">
    <section class="editorial-panel mb-8 p-6" data-section="category-guide">
      <h2 class="gp-link-card-title mb-3">Define compliance-first before the demo</h2>
      <p class="text-brand-muted mb-5">
        This guide lists the records, proof, dates, and audit history a compliance-first grant system should connect.
      </p>
      <a class="gp-mkt-btn secondary" href="/resources/guides/compliance-first-grant-management-system/">
        Read the guide
      </a>
    </section>
    {contextualVideo && (
      <section class="editorial-panel mb-8 p-6" data-section="contextual-video">
        <h2 class="gp-link-card-title mb-5">See it in action</h2>
        <VideoEmbed
          youtubeId={contextualVideo.youtubeId}
          iframeTitle={contextualVideo.title}
          playLabel={`Play: ${contextualVideo.shortTitle}`}
        />
        <script type="application/ld+json" set:html={JSON.stringify(videoSchema(contextualVideo))} />
      </section>
    )}
  </Fragment>
</GrantRecipientCategoryPage>
