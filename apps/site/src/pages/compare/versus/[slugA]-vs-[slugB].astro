---
import { getPublicApiBaseUrl } from "@grantpipe/ui/site/lib/public-api-url"
import "../../../styles/global.css"
import { getCollection, render } from "astro:content"
import ComparisonLayout from "@grantpipe/ui/site/layouts/comparison-layout.astro"
import { LeadMagnetSignup } from "@grantpipe/ui/site/components/lead-magnet-signup"
import ComparisonTable from "@grantpipe/ui/site/components/comparison-table.astro"
import FaqSection from "@grantpipe/ui/site/components/faq-section.astro"
import RelatedPages from "@grantpipe/ui/site/components/related-pages.astro"
import DataTableBlock from "@grantpipe/ui/site/seo/data-table-block.astro"
import ProsConsBlock from "@grantpipe/ui/site/seo/pros-cons-block.astro"
import AnswerBlock from "@grantpipe/ui/site/seo/answer-block.astro"
import { siteConfig, shouldShowMobileStickyCta } from "@/config/site"
import { buildVersusBreadcrumbs } from "@/lib/breadcrumbs"
import { buildVersusComparisonTable } from "@/lib/comparison-rows"
import {
  buildContentMap,
  buildVersusComparisonPath,
  normalizeVersusComparisonTitle,
  orderVersusSubjects,
} from "@/lib/page-helpers"
import { resolveLeadMagnetOffer, resolveExitLeadMagnetOffer } from "@/lib/lead-magnet-routing"
import { getCompetitorProfile } from "@/config/market-facts"
import { resolveRelatedPageLinks } from "@grantpipe/ui/site/lib/related-page-resolver"
import PricingSummaryBlock from "@/components/pricing-summary-block.astro"
import { resolvePricingCopyTree } from "@/lib/pricing-copy-tokens"

export async function getStaticPaths() {
  const entries = await getCollection("comparisons")
  return entries.map((entry) => {
    const [firstCompetitor, secondCompetitor] = orderVersusSubjects(
      entry.data.competitorA,
      entry.data.competitorB,
    )

    return {
      params: {
        slugA: firstCompetitor.slug,
        slugB: secondCompetitor.slug,
      },
      props: { entry },
    }
  })
}

const { entry } = Astro.props
const { Content } = await render(entry)
const resolvedEntryData = resolvePricingCopyTree(entry.data)
const {
  title,
  description,
  seoTitle,
  seoDescription,
  bluf,
  buyerStage,
  publishedAt,
  updatedAt,
  lastReviewedAt,
  verifiedAt,
  competitorA,
  competitorB,
  verdict,
  faqs = [],
  relatedPages = [],
  tableData,
  proscons = [],
  answers = [],
  disableProsConsSchema,
  sourceUrls = [],
} = resolvedEntryData
const normalizedTitle = normalizeVersusComparisonTitle(title, competitorA, competitorB)
const normalizedSeoTitle =
  seoTitle === undefined
    ? undefined
    : normalizeVersusComparisonTitle(seoTitle, competitorA, competitorB)
const canonicalPath = buildVersusComparisonPath(competitorA, competitorB)
const competitorProfileA = getCompetitorProfile(competitorA.slug)
const competitorProfileB = getCompetitorProfile(competitorB.slug)

const [alternatives, comparisons, pricingBreakdowns, listicles, guides, statePages, cityPages, verticalPages, leadMagnets, faqHubs, benchmarks] = await Promise.all([
  getCollection("alternatives"),
  getCollection("comparisons"),
  getCollection("pricing-breakdowns"),
  getCollection("listicles"),
  getCollection("guides"),
  getCollection("state-pages"),
  getCollection("city-pages"),
  getCollection("vertical-pages"),
  getCollection("lead-magnets"),
  getCollection("faq-hubs"),
  getCollection("benchmarks"),
])
const contentMap = buildContentMap({ alternatives, comparisons, pricingBreakdowns, listicles, guides, statePages, cityPages, verticalPages, leadMagnets, faqHubs, benchmarks })

const breadcrumbs = buildVersusBreadcrumbs(competitorA, competitorB, canonicalPath)
const comparisonTable = buildVersusComparisonTable(
  competitorA,
  competitorB,
  siteConfig.name,
)
const relatedPageLinks = resolveRelatedPageLinks(relatedPages, contentMap)
const resolvedSourceUrls =
  sourceUrls.length > 0
    ? sourceUrls
    : [...(competitorProfileA?.sourceUrls ?? []), ...(competitorProfileB?.sourceUrls ?? [])]
const resolvedVerifiedAt =
  verifiedAt ??
  competitorProfileA?.verifiedAt ??
  competitorProfileB?.verifiedAt
const resolvedLastReviewedAt = lastReviewedAt ?? resolvedVerifiedAt
const leadMagnet = resolveLeadMagnetOffer(siteConfig, leadMagnets, {
  family: "comparison",
  explicitSlug: entry.data.leadMagnetSlug,
  relatedPages,
})
const exitLeadMagnet = resolveExitLeadMagnetOffer(siteConfig, leadMagnets, {
  family: "comparison",
  exitSlug: entry.data.exitMagnetSlug,
  leadMagnetSlug: entry.data.leadMagnetSlug,
  relatedPages,
})
const publicApiUrl = getPublicApiBaseUrl()

---

<ComparisonLayout
  title={normalizedTitle}
  description={description}
  seoTitle={normalizedSeoTitle}
  seoDescription={seoDescription}
  bluf={bluf}
  buyerStage={buyerStage}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  lastReviewedAt={resolvedLastReviewedAt}
  verifiedAt={resolvedVerifiedAt}
  canonicalPath={canonicalPath}
  config={siteConfig}
  breadcrumbs={breadcrumbs}
  answers={answers?.map(a => ({ question: a.q, answer: a.a }))}
  sourceUrls={resolvedSourceUrls}
  leadMagnet={exitLeadMagnet}
  showStickyMobileCta={shouldShowMobileStickyCta(canonicalPath)}
>
  <section class="editorial-panel editorial-panel--soft mb-8 p-5">
    <p class="gp-proof-label">Best overall: GrantPipe</p>
    <p class="gp-link-card-copy">
      GrantPipe is the winner when the decision includes donor CRM, grant operations,
      restricted-fund visibility, and compliance reporting in one workflow.
    </p>
    <a
      href={siteConfig.funnel.bofu.ctaTarget}
      class="gp-mkt-btn primary sm mt-4 inline-block no-underline rounded-full"
      data-cta-button=""
      data-cta-page-family="compare-versus"
      data-cta-buyer-stage="bofu"
      data-cta-placement="editorial-panel-cta"
      data-cta-intent="convert"
      data-cta-target={siteConfig.funnel.bofu.ctaTarget}
    >
      {siteConfig.funnel.bofu.ctaText}
    </a>
  </section>

  <ComparisonTable
    headers={comparisonTable.headers}
    rows={comparisonTable.rows}
    highlightColumn={comparisonTable.highlightColumn}
    variant="editorial"
  />

  <Content />

  <LeadMagnetSignup
    client:load
    apiUrl={publicApiUrl}
    sourcePage={canonicalPath}
    leadMagnet={leadMagnet}
    privacyNote="We'll email the resource and a short follow-up sequence. Unsubscribe any time."
    trialCtaHref={siteConfig.funnel.bofu.ctaTarget}
    trialCtaText={siteConfig.funnel.bofu.ctaText}
  />

  {tableData && (
    <DataTableBlock name={tableData.name} description={tableData.description} columns={tableData.columns} rows={tableData.rows} />
  )}
  {proscons?.map((pc) => (
    <ProsConsBlock subject={pc.subject} pros={pc.pros} cons={pc.cons} emitSchema={!disableProsConsSchema} />
  ))}
  {answers?.map((a) => (
    <AnswerBlock question={a.q} answer={a.a} />
  ))}

  <section class="editorial-panel editorial-panel--soft my-10 p-5">
    <p class="gp-proof-label">Verdict</p>
    <p class="gp-link-card-copy">{verdict}</p>
  </section>

  <PricingSummaryBlock />

  <FaqSection
    faqs={faqs}
    heading="Frequently Asked Questions"
    showBottomCta={false}
    ctaVariant="compact"
  />
  {relatedPages.length > 0 && (
    <RelatedPages
      pages={relatedPageLinks}
      heading="Related Comparisons"
      variant="editorial"
    />
  )}
</ComparisonLayout>
