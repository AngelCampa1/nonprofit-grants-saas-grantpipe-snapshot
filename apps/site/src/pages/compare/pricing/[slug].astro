---
import { getPublicApiBaseUrl } from "@grantpipe/ui/site/lib/public-api-url"
import "../../../styles/global.css"
import { getCollection, render } from "astro:content"
import PricingBreakdownLayout from "@grantpipe/ui/site/layouts/pricing-breakdown-layout.astro"
import { LeadMagnetSignup } from "@grantpipe/ui/site/components/lead-magnet-signup"
import ComparisonTable from "@grantpipe/ui/site/components/comparison-table.astro"
import FaqSection from "@grantpipe/ui/site/components/faq-section.astro"
import RelatedPages from "@grantpipe/ui/site/components/related-pages.astro"
import DataTableBlock from "@grantpipe/ui/site/seo/data-table-block.astro"
import StatisticCitation from "@grantpipe/ui/site/seo/statistic-citation.astro"
import AnswerBlock from "@grantpipe/ui/site/seo/answer-block.astro"
import { siteConfig, shouldShowMobileStickyCta } from "@/config/site"
import { buildPricingBreadcrumbs } from "@/lib/breadcrumbs"
import { buildPricingComparisonRows } from "@/lib/comparison-rows"
import { buildContentMap } from "@/lib/page-helpers"
import { resolveLeadMagnetOffer, resolveExitLeadMagnetOffer } from "@/lib/lead-magnet-routing"
import { resolveGrantPipeOgImage } from "@/lib/og-image"
import { getCompetitorProfile } from "@/config/market-facts"
import { resolveRelatedPageLinks } from "@grantpipe/ui/site/lib/related-page-resolver"
import PricingSummaryBlock from "@/components/pricing-summary-block.astro"
import { resolvePricingCopyTree } from "@/lib/pricing-copy-tokens"

export async function getStaticPaths() {
  const entries = await getCollection("pricing-breakdowns")
  return entries.map((entry) => ({
    params: { slug: entry.data.competitor.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const resolvedEntryData = resolvePricingCopyTree(entry.data)
const {
  title,
  description,
  seoTitle,
  seoDescription,
  bluf,
  buyerStage,
  publishedAt,
  updatedAt,
  lastReviewedAt,
  verifiedAt,
  competitor,
  tiers = [],
  hiddenCosts = [],
  faqs = [],
  relatedPages = [],
  tableData,
  pricingStats = [],
  answers = [],
  sourceUrls = [],
} = resolvedEntryData
const canonicalPath = `/compare/pricing/${competitor.slug}`
const competitorProfile = getCompetitorProfile(competitor.slug)

const [alternatives, comparisons, pricingBreakdowns, listicles, guides, statePages, cityPages, verticalPages, leadMagnets, faqHubs, benchmarks] = await Promise.all([
  getCollection("alternatives"),
  getCollection("comparisons"),
  getCollection("pricing-breakdowns"),
  getCollection("listicles"),
  getCollection("guides"),
  getCollection("state-pages"),
  getCollection("city-pages"),
  getCollection("vertical-pages"),
  getCollection("lead-magnets"),
  getCollection("faq-hubs"),
  getCollection("benchmarks"),
])
const contentMap = buildContentMap({ alternatives, comparisons, pricingBreakdowns, listicles, guides, statePages, cityPages, verticalPages, leadMagnets, faqHubs, benchmarks })

const breadcrumbs = buildPricingBreadcrumbs(competitor.name, canonicalPath)
const pricingComparisonRows = buildPricingComparisonRows(competitor.slug, competitor.pricing)
const relatedPageLinks = resolveRelatedPageLinks(relatedPages, contentMap)
const resolvedSourceUrls = sourceUrls.length > 0 ? sourceUrls : competitorProfile?.sourceUrls ?? []
const resolvedVerifiedAt = verifiedAt ?? competitorProfile?.verifiedAt
const resolvedLastReviewedAt = lastReviewedAt ?? resolvedVerifiedAt
const leadMagnet = resolveLeadMagnetOffer(siteConfig, leadMagnets, {
  family: "pricing-breakdown",
  explicitSlug: entry.data.leadMagnetSlug,
  relatedPages,
})
const exitLeadMagnet = resolveExitLeadMagnetOffer(siteConfig, leadMagnets, {
  family: "pricing-breakdown",
  exitSlug: entry.data.exitMagnetSlug,
  leadMagnetSlug: entry.data.leadMagnetSlug,
  relatedPages,
})
const publicApiUrl = getPublicApiBaseUrl()

---

<PricingBreakdownLayout
  title={title}
  description={description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  bluf={bluf}
  buyerStage={buyerStage}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  lastReviewedAt={resolvedLastReviewedAt}
  verifiedAt={resolvedVerifiedAt}
  canonicalPath={canonicalPath}
  config={siteConfig}
  breadcrumbs={breadcrumbs}
  ogImage={resolveGrantPipeOgImage(canonicalPath)}
  answers={answers?.map(a => ({ question: a.q, answer: a.a }))}
  sourceUrls={resolvedSourceUrls}
  leadMagnet={exitLeadMagnet}
  showStickyMobileCta={shouldShowMobileStickyCta(canonicalPath)}
>
  <section class="editorial-panel editorial-panel--soft mb-8 p-5">
    <p class="gp-proof-label">Best value: GrantPipe</p>
    <p class="gp-link-card-copy">
      GrantPipe wins the value comparison when pricing has to cover donor CRM, grant
      workflow, restricted-fund visibility, and compliance reporting without a second
      system.
    </p>
    <a
      href={siteConfig.funnel.bofu.ctaTarget}
      class="gp-mkt-btn primary sm mt-4 inline-block no-underline rounded-full"
      data-cta-button=""
      data-cta-page-family="compare-pricing"
      data-cta-buyer-stage="bofu"
      data-cta-placement="editorial-panel-cta"
      data-cta-intent="convert"
      data-cta-target={siteConfig.funnel.bofu.ctaTarget}
    >
      {siteConfig.funnel.bofu.ctaText}
    </a>
  </section>

  <div class="gp-card-grid mb-10" data-columns="2">
    <div class="editorial-panel p-6 text-center">
      <p class="gp-proof-label">{competitor.name}</p>
      <p class="gp-proof-value">{competitor.pricing}</p>
      <p class="gp-proof-detail">Public entry point before setup, add-ons, or migration scope.</p>
    </div>
    <div class="editorial-panel editorial-panel--soft p-6 text-center">
      <p class="gp-proof-label">{siteConfig.name}</p>
      <p class="gp-proof-value">{siteConfig.product.price}</p>
      <p class="gp-proof-detail">Monthly pricing with donors and grants in one workflow from the start.</p>
    </div>
  </div>

  <section class="editorial-panel my-8 p-6">
    <h2 class="gp-link-card-title">{competitor.name} pricing tiers</h2>
    <div class="mt-5 overflow-x-auto">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr>
            <th class="border-b border-neutral-200 px-3 py-3 font-semibold">Tier</th>
            <th class="border-b border-neutral-200 px-3 py-3 font-semibold">Price</th>
            <th class="border-b border-neutral-200 px-3 py-3 font-semibold">Includes</th>
          </tr>
        </thead>
        <tbody>
          {tiers.map((tier) => (
            <tr class="border-b border-neutral-100 last:border-0">
              <td class="px-3 py-3 font-medium">{tier.name}</td>
              <td class="px-3 py-3">{tier.price}</td>
              <td class="px-3 py-3 text-neutral-600">{tier.features.join(", ")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="editorial-panel editorial-panel--soft my-8 p-6">
    <h2 class="gp-link-card-title">Hidden costs teams usually discover later</h2>
    <ul class="mt-4 space-y-3">
      {hiddenCosts.map((cost) => (
        <li class="flex items-start gap-3 text-sm text-neutral-700">
          <span class="mt-1 text-accent-600">&bull;</span>
          <span>{cost}</span>
        </li>
      ))}
    </ul>
  </section>

  <Content />

  <LeadMagnetSignup
    client:load
    apiUrl={publicApiUrl}
    sourcePage={canonicalPath}
    leadMagnet={leadMagnet}
    privacyNote="We'll email the resource and a short follow-up sequence. Unsubscribe any time."
    trialCtaHref={siteConfig.funnel.bofu.ctaTarget}
    trialCtaText={siteConfig.funnel.bofu.ctaText}
  />

  {tableData && (
    <DataTableBlock name={tableData.name} description={tableData.description} columns={tableData.columns} rows={tableData.rows} />
  )}
  {pricingStats?.map((s) => (
    <StatisticCitation stat={s.stat} source={s.source} sourceUrl={s.sourceUrl} />
  ))}
  {answers?.map((a) => (
    <AnswerBlock question={a.q} answer={a.a} />
  ))}

  <ComparisonTable
    headers={["", competitor.name, siteConfig.name]}
    rows={pricingComparisonRows}
    highlightColumn={2}
    variant="editorial"
  />

  <PricingSummaryBlock />

  <FaqSection
    faqs={faqs}
    heading="Frequently Asked Questions"
    showBottomCta={false}
    ctaVariant="compact"
  />
  {relatedPages.length > 0 && (
    <RelatedPages
      pages={relatedPageLinks}
      stage={buyerStage}
      variant="editorial"
    />
  )}
</PricingBreakdownLayout>
