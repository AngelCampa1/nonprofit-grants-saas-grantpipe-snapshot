---
import "../../styles/global.css";
import FinalCta from "@/components/final-cta.astro";
import Button from "@/components/ui/button.astro";
import { getSignupCtaTarget, shouldShowMobileStickyCta, siteConfig } from "@/config/site";
import { getAppLoginUrl } from "@/lib/app-url";
import BaseLayout from "@grantpipe/ui/site/layouts/base-layout.astro";
import SiteFooter from "@grantpipe/ui/site/components/site-footer.astro";
import SiteHeader from "@grantpipe/ui/site/components/site-header.astro";
import { ExitIntentPopup } from "@grantpipe/ui/site/components/exit-intent-popup";
import { resolveExitPopupProps } from "@grantpipe/ui/site/lib/exit-popup-props";
import { getPublicApiBaseUrl } from "@grantpipe/ui/site/lib/public-api-url";
import { getCollection } from "astro:content";
import { resolveExitLeadMagnetOffer } from "@/lib/lead-magnet-routing";
import ComparisonTable, { type ComparisonRow } from "@/components/comparison-table.astro";

const featureRows: ComparisonRow[] = [
  {
    feature: "Side of the transaction",
    grantpipe: "Applicant-side (organization applies for grants)",
    competitor: "Grantmaker-side (organization receives applications)",
  },
  {
    feature: "Donor CRM",
    grantpipe: true,
    competitor: false,
  },
  {
    feature: "Restricted-fund tracking",
    grantpipe: true,
    competitor: false,
  },
  {
    feature: "Application intake",
    grantpipe: "Not a core function",
    competitor: "Core strength",
  },
  {
    feature: "Compliance reporting workflow",
    grantpipe: "SF-425 cadence, Single Audit prep, deadline alerts",
    competitor: "Not a core function",
  },
  {
    feature: "Pricing model",
    grantpipe: "Flat monthly SaaS",
    competitor: "Contact for pricing",
  },
];

const leadMagnets = await getCollection("lead-magnets");
const exitLeadMagnet = resolveExitLeadMagnetOffer(siteConfig, leadMagnets, { family: "comparison" });
const exitPopupProps = siteConfig.exitPopup?.enabled !== false ? resolveExitPopupProps(siteConfig) : undefined;
const publicApiUrl = getPublicApiBaseUrl();
---

<BaseLayout
  title="GrantPipe vs Submittable | GrantPipe"
  description="A short comparison of GrantPipe and Submittable for nonprofits separating applicant-side grant operations from application intake workflow."
  canonicalUrl={`https://${siteConfig.domain}/compare/grantpipe-vs-submittable/`}
  siteName={siteConfig.name}
  ogType="website"
  twitterSite={siteConfig.social?.twitterHandle}
  theme={siteConfig.theme}
  fonts={siteConfig.theme.fonts}
  themeColor={siteConfig.theme.primary}
  appleTouchIcon={siteConfig.appleTouchIcon}
  siteUrl={`https://${siteConfig.domain}`}
  siteLogo={siteConfig.logo?.light ? `https://${siteConfig.domain}${siteConfig.logo.light}` : undefined}
  siteFounder={siteConfig.author}
  siteSameAs={siteConfig.sameAs}
  showStickyMobileCta={shouldShowMobileStickyCta(Astro.url.pathname)}
>
  <SiteHeader
    slot="header"
    siteName={siteConfig.name}
    navItems={siteConfig.nav?.items}
    ctaText={siteConfig.funnel.bofu.ctaText}
    ctaHref={siteConfig.funnel.bofu.ctaTarget}
    loginHref={getAppLoginUrl()}
    ctaVariant="primary"
    ctaPill
    currentPath={Astro.url.pathname}
    logoLight={siteConfig.logo?.light}
  />

  <main class="gp-marketing-shell" data-marketing-page="compare-submittable">
    <section class="gp-section">
      <div class="gp-wrap gp-hero">
        <div class="gp-hero-copy">
          <nav class="versus-breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              <li aria-hidden="true" class="versus-breadcrumb__sep">/</li>
              <li><a href="/compare/">Compare</a></li>
              <li aria-hidden="true" class="versus-breadcrumb__sep">/</li>
              <li aria-current="page">GrantPipe vs. Submittable</li>
            </ol>
          </nav>
          <p class="gp-eyebrow-pill">GrantPipe vs. Submittable</p>
          <h1>Submittable manages applications you receive. GrantPipe manages grants you win.</h1>
          <p>
            Submittable fits grantmaker-side intake, review, and scoring. GrantPipe
            fits applicant-side nonprofit teams that need donor records, active grants,
            restricted funds, reporting deadlines, and compliance evidence in one system.
          </p>
          <div class="gp-hero-actions">
            <Button variant="primary" size="lg" href={getSignupCtaTarget()}>
              Start 1-month free trial
            </Button>
            <Button variant="ghost" size="md" href="/compare/versus/grantpipe-vs-submittable/">
              Read the full comparison
            </Button>
          </div>
        </div>
      </div>
    </section>

    <section class="gp-section alt" data-section="comparison-table">
      <div class="gp-wrap scroll-in">
        <header class="versus-section-head">
          <p class="gp-eyebrow-pill">Feature comparison</p>
          <h2>GrantPipe vs. Submittable, feature by feature</h2>
        </header>
        {/* comparison-table.astro renders its own overflow-x-auto scroller with a sticky left-0 first column */}
        <div class="versus-comparison-table-wrap overflow-x-auto">
          <ComparisonTable competitorName="Submittable" rows={featureRows} caption="GrantPipe vs Submittable feature comparison" />
        </div>
      </div>
    </section>

    <section class="gp-section">
      <div class="gp-wrap">
        <FinalCta
          title="Choose based on which side of the grant you manage."
          body="Use GrantPipe when your team applies for grants and needs to manage awards, restrictions, deadlines, and evidence after funding."
          primaryHref={getSignupCtaTarget()}
          secondaryHref="/pricing/"
          secondaryLabel="See pricing"
          items={[
            "Post-award deadlines, evidence, and restricted-fund workflow.",
            "Restricted fund and grant records in one place.",
            "$10/active grant/month overage after soft headroom.",
          ]}
        />
      </div>
    </section>
  </main>

  <SiteFooter
    slot="footer"
    siteName={siteConfig.name}
    tagline={siteConfig.tagline}
    linkGroups={siteConfig.footer?.linkGroups ?? []}
    legalLinks={siteConfig.footer?.legalLinks ?? []}
    contactEmail={siteConfig.contactEmail}
    logoLight={siteConfig.logo?.light}
    captureVariant="none"
    currentPath={Astro.url.pathname}
  />
  {exitPopupProps && (
    <ExitIntentPopup
      client:idle
      apiUrl={publicApiUrl}
      {...exitPopupProps}
      leadMagnet={exitLeadMagnet}
    />
  )}
</BaseLayout>

<style>
  .versus-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--gp-ink-500);
  }

  .versus-breadcrumb a {
    color: var(--gp-ink-700);
    text-decoration: none;
  }

  .versus-breadcrumb a:hover,
  .versus-breadcrumb a:focus-visible {
    color: var(--gp-emerald-700);
    outline: none;
  }

  .versus-breadcrumb [aria-current="page"] {
    color: var(--gp-ink-900);
    font-weight: 500;
  }

  .versus-breadcrumb__sep {
    color: var(--gp-ink-400);
  }

  .versus-section-head {
    margin-bottom: 1.5rem;
  }

  .versus-section-head h2 {
    font-family: var(--font-heading, inherit);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.2;
    font-weight: 700;
    color: var(--gp-ink-900);
    margin: 0;
  }

  .versus-section-head .gp-eyebrow-pill {
    margin-bottom: 0.5rem;
  }

  /* comparison-table.astro's feature column stays pinned while the table
     scrolls horizontally on narrow viewports. */
  .versus-comparison-table-wrap :global(.gp-comparison-table__feature) {
    position: sticky;
    left: 0;
  }
</style>
