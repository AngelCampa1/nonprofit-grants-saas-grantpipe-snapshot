---
import "../../styles/global.css"
import { getCollection } from "astro:content"
import { getContentEntrySlug } from "@/lib/content-entry-slug"
import CategoryHub from "@grantpipe/ui/site/hubs/category-hub.astro"
import { siteConfig, shouldShowMobileStickyCta } from "@/config/site"
import { sortByUpdatedAtDesc } from "@grantpipe/ui/site/lib/collections"
import { resolveExitLeadMagnetOffer } from "@/lib/lead-magnet-routing"
import { buildWorkflowHubModel } from "@/lib/workflow-hub"

const leadMagnets = await getCollection("lead-magnets")
const exitLeadMagnet = resolveExitLeadMagnetOffer(siteConfig, leadMagnets, { family: "solution" })
const entries = await getCollection("workflows")
const sorted = sortByUpdatedAtDesc(entries)
const workflowHub = buildWorkflowHubModel(
  sorted,
  (e) => `/workflows/${getContentEntrySlug(e)}`,
)
const page = {
  data: workflowHub.items,
  currentPage: 1,
  lastPage: 1,
  url: { prev: undefined, next: undefined },
}
---

<CategoryHub
  config={siteConfig}
  title="Workflows"
  description="Find the work you need to fix. Start by topic, stage, or task."
  variant="editorial"
  items={workflowHub.items}
  page={page}
  basePath="/workflows"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Workflows", href: "/workflows" },
  ]}
  emptyStateHeading="No workflows are published yet."
  emptyStateBody="Workflows are being authored. Check the resources hub for guides and templates in the meantime."
  showStickyMobileCta={shouldShowMobileStickyCta(Astro.url.pathname)}
  leadMagnet={exitLeadMagnet}
  renderListing={false}
>
  <section slot="intro" class="mb-10 space-y-10">
    <section aria-label="Workflow topics">
      <div class="mb-5 max-w-2xl">
        <p class="gp-kicker--accent">Topic paths</p>
        <h2 class="mt-3 font-heading text-[length:var(--text-heading)] font-bold text-brand-text">
          Pick a workflow by topic.
        </h2>
        <p class="mt-3 text-brand-muted">
          Start with the work you need to fix. Each topic shows a short list.
        </p>
      </div>
      <div data-workflow-topic-grid class="grid gap-4 md:grid-cols-2">
        {workflowHub.topicSummaries.map((topic) => (
          <article class="gp-card-base h-full rounded-lg p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="gp-proof-label">Topic</p>
                <h3 class="mt-2 font-heading text-[length:var(--text-subheading)] font-bold text-brand-text">
                  {topic.title}
                </h3>
              </div>
              <span class="rounded-full border border-[var(--gp-ink-200)] px-3 py-1 text-[length:var(--text-caption)] font-medium text-brand-muted">
                {topic.totalCount} {topic.totalCount === 1 ? "workflow" : "workflows"}
              </span>
            </div>
            <p class="mt-3 text-[length:var(--text-body)] leading-7 text-brand-muted">
              {topic.description}
            </p>
            <div class="mt-5 grid gap-2">
              {topic.previewItems.map((item) => (
                <a
                  href={item.href}
                  class="rounded-full px-3 py-2 text-[length:var(--text-caption)] font-medium text-brand-text no-underline transition-colors hover:bg-[var(--gp-paper-2)] hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
                >
                  {item.title}
                </a>
              ))}
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              <a class="gp-filter-chip" href={`${topic.href}/`}>See topic path</a>
              {topic.overflowCount > 0 && (
                <span class="gp-filter-chip" aria-label={`${topic.overflowCount} more workflows in this topic`}>
                  {topic.overflowCount} more
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section aria-label="Workflow stages">
      <div class="mb-5 max-w-2xl">
        <p class="gp-kicker--accent">Funnel stage</p>
        <h2 class="mt-3 font-heading text-[length:var(--text-heading)] font-bold text-brand-text">
          Pick by next step.
        </h2>
        <p class="mt-3 text-brand-muted">
          Use this if you know your next decision.
        </p>
      </div>
      <div data-workflow-stage-grid class="grid gap-4 lg:grid-cols-3">
        {workflowHub.stageSections.map((section) => (
          <article class="gp-card-base h-full rounded-lg p-5">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
              <span class="rounded-full border border-[var(--gp-ink-200)] px-3 py-1 text-[length:var(--text-caption)] font-medium text-brand-primary">
                {section.label}
              </span>
              <span class="text-[length:var(--text-caption)] text-brand-muted">
                {section.totalCount} {section.totalCount === 1 ? "workflow" : "workflows"}
              </span>
            </div>
            <h3 class="font-heading text-[length:var(--text-subheading)] font-bold text-brand-text">
              {section.heading}
            </h3>
            <p class="mt-3 text-[length:var(--text-body)] leading-7 text-brand-muted">
              {section.description}
            </p>
            <div class="mt-5 grid gap-3">
              {section.items.map((item) => (
                <a
                  href={item.href}
                  class="rounded-lg border border-[var(--gp-ink-100)] bg-[var(--gp-paper)] p-3 no-underline transition-[border-color,background-color,color] hover:border-[var(--gp-emerald-200)] hover:bg-[var(--gp-paper-2)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
                >
                  <span class="block font-heading text-[length:var(--text-body)] font-bold leading-snug text-brand-text">
                    {item.title}
                  </span>
                  {item.metadata?.timeEstimate && (
                    <span class="mt-1 block text-[length:var(--text-caption)] text-brand-muted">
                      {item.metadata.timeEstimate}
                    </span>
                  )}
                </a>
              ))}
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              <a class="gp-filter-chip" href={`${section.nextStepHref}/`}>
                {section.nextStepLabel}
              </a>
              {section.overflowCount > 0 && (
                <span class="gp-filter-chip" aria-label={`${section.overflowCount} more workflows in this stage`}>
                  {section.overflowCount} more
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </section>

  <section
    slot="cta"
    data-workflow-next-step
    class="mt-10 rounded-xl border border-[var(--gp-ink-100)] bg-[var(--gp-paper-2)] p-6 sm:p-8"
  >
    <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
      <div class="max-w-2xl">
        <p class="gp-kicker--accent">Next step</p>
        <h2 class="mt-3 font-heading text-[length:var(--text-heading)] font-bold text-brand-text">
          See how the work fits in GrantPipe.
        </h2>
        <p class="mt-3 text-brand-muted">
          Use the product tour when a workflow needs one system for grants, funds, and reports.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/product/"
          class="inline-flex rounded-full bg-brand-primary px-5 py-3 text-[length:var(--text-caption)] font-bold text-white no-underline shadow-sm transition hover:bg-brand-primary-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
        >
          See product tour
        </a>
        <a
          href={siteConfig.funnel.bofu.ctaTarget}
          class="inline-flex rounded-full border border-[var(--gp-ink-200)] bg-white px-5 py-3 text-[length:var(--text-caption)] font-bold text-brand-text no-underline transition hover:border-[var(--gp-emerald-300)] hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
        >
          Start a 1-month free trial
        </a>
      </div>
    </div>
  </section>
</CategoryHub>
