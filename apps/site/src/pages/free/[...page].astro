---
import "../../styles/global.css"
import { getCollection } from "astro:content"
import { getContentEntrySlug } from "@/lib/content-entry-slug"
import CategoryHub from "@grantpipe/ui/site/hubs/category-hub.astro"
import PublicSignupCta from "@grantpipe/ui/site/components/public-signup-cta"
import { sortByUpdatedAtDesc } from "@grantpipe/ui/site/lib/collections"
import { siteConfig, shouldShowMobileStickyCta } from "@/config/site"
import { hubFaqs } from "@/config/hub-faqs"
import {
  resolveFeaturedLeadMagnetSlugs,
  resolveExitLeadMagnetOffer,
} from "@/lib/lead-magnet-routing"
import { buildFreeResourceHubModel } from "@/lib/free-resource-hub"
import Card from "@/components/ui/card.astro"
import { ACTIVE_LEAD_MAGNET_SLUGS } from "@grantpipe/shared"

export async function getStaticPaths({ paginate }: import("astro").GetStaticPathsOptions) {
  const entries = await getCollection("lead-magnets")
  const sorted = sortByUpdatedAtDesc(
    entries.filter((entry) =>
      (ACTIVE_LEAD_MAGNET_SLUGS as readonly string[]).includes(getContentEntrySlug(entry)),
    ),
  )
  const freeResourceHub = buildFreeResourceHubModel(sorted, (entry) => `/free/${getContentEntrySlug(entry)}`)
  return paginate(freeResourceHub.items, { pageSize: 12 })
}

const { page } = Astro.props
const allLeadMagnets = await getCollection("lead-magnets")
const activeLeadMagnetSlugs = new Set<string>(ACTIVE_LEAD_MAGNET_SLUGS)
const activeLeadMagnets = sortByUpdatedAtDesc(
  allLeadMagnets.filter((entry) =>
    activeLeadMagnetSlugs.has(getContentEntrySlug(entry)),
  ),
)
const freeResourceHub = buildFreeResourceHubModel(activeLeadMagnets, (entry) => `/free/${getContentEntrySlug(entry)}`)
const featuredLeadMagnets = resolveFeaturedLeadMagnetSlugs(siteConfig)
  .map((slug) => activeLeadMagnets.find((entry) => getContentEntrySlug(entry) === slug))
  .filter((entry): entry is NonNullable<typeof entry> => entry !== undefined)
const exitLeadMagnet = resolveExitLeadMagnetOffer(siteConfig, activeLeadMagnets, {
  family: "guide",
})
---

<CategoryHub
  config={siteConfig}
  leadMagnet={exitLeadMagnet}
  title="Free Checklists, Templates, and Scorecards"
  description="Free tools for grant compliance, audit prep, restricted funds, CRM costs, and grant tracking."
  items={page.data}
  page={page}
  basePath="/free"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Free", href: "/free" },
  ]}
  faqs={hubFaqs["/free"]}
  emptyStateHeading="No downloads match this page yet."
  emptyStateBody="Browse the resources hub for guides, templates, and benchmarks while new downloads are being prepared."
  showStickyMobileCta={shouldShowMobileStickyCta("/free")}
>
  <section slot="intro" class="mb-10 space-y-10">
    <section class="gp-resource-decision-panel editorial-panel p-6" aria-label="Free resource start">
      <p class="gp-proof-label">Start here</p>
      <h2 class="gp-link-card-title">Pick the right download.</h2>
      <p class="gp-link-card-copy mt-3">
        Use a checklist, worksheet, or template first. Then move the job into
        GrantPipe. Use it when your team needs one place for grants, funds, and
        reports.
      </p>
    </section>

    <section aria-label="Featured free resources">
      <div class="mb-5 max-w-2xl">
        <p class="gp-kicker--accent">Featured</p>
        <h2 class="mt-3 font-heading text-[length:var(--text-heading)] font-bold text-brand-text">
          Start with one of these.
        </h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {featuredLeadMagnets.map((entry) => (
          <Card variant="interactive" href={`/free/${getContentEntrySlug(entry)}`}>
            <p class="gp-proof-label">Featured resource</p>
            <h3 class="mt-3 text-[length:var(--text-body-lg)] font-heading font-bold text-brand-text">
              {entry.data.title}
            </h3>
            <p class="mt-3 text-[length:var(--text-caption)] leading-6 text-brand-muted">
              {entry.data.description}
            </p>
            <span class="mt-5 inline-flex text-[length:var(--text-caption)] font-medium text-brand-primary">
              Get resource
            </span>
          </Card>
        ))}
      </div>
    </section>

    <section aria-label="Free resource topics">
      <div class="mb-5 max-w-2xl">
        <p class="gp-kicker--accent">Topic paths</p>
        <h2 class="mt-3 font-heading text-[length:var(--text-heading)] font-bold text-brand-text">
          Pick a free tool by topic.
        </h2>
        <p class="mt-3 text-brand-muted">
          Start with the job you need to fix. Each topic shows a short list.
        </p>
      </div>
      <div data-free-topic-grid class="grid gap-4 md:grid-cols-2">
        {freeResourceHub.topicSummaries.map((topic) => (
          <article class="gp-card-base h-full rounded-lg p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="gp-proof-label">Topic</p>
                <h3 class="mt-2 font-heading text-[length:var(--text-subheading)] font-bold text-brand-text">
                  {topic.title}
                </h3>
              </div>
              <span class="rounded-full border border-[var(--gp-ink-200)] px-3 py-1 text-[length:var(--text-caption)] font-medium text-brand-muted">
                {topic.totalCount} {topic.totalCount === 1 ? "tool" : "tools"}
              </span>
            </div>
            <p class="mt-3 text-[length:var(--text-body)] leading-7 text-brand-muted">
              {topic.description}
            </p>
            <div class="mt-5 grid gap-2">
              {topic.previewItems.map((item) => (
                <a
                  href={item.href}
                  class="rounded-full px-3 py-2 text-[length:var(--text-caption)] font-medium text-brand-text no-underline transition-colors hover:bg-[var(--gp-paper-2)] hover:text-brand-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
                >
                  {item.title}
                </a>
              ))}
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              <a class="gp-filter-chip" href={`${topic.href}/`}>See topic path</a>
              {topic.overflowCount > 0 && (
                <span class="gp-filter-chip" aria-label={`${topic.overflowCount} more free tools in this topic`}>
                  {topic.overflowCount} more
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section aria-label="Free resource stages">
      <div class="mb-5 max-w-2xl">
        <p class="gp-kicker--accent">Next step</p>
        <h2 class="mt-3 font-heading text-[length:var(--text-heading)] font-bold text-brand-text">
          Pick by next step.
        </h2>
        <p class="mt-3 text-brand-muted">
          Use this if you know what comes next.
        </p>
      </div>
      <div data-free-stage-grid class="grid gap-4 lg:grid-cols-3">
        {freeResourceHub.stageSections.map((section) => (
          <article class="gp-card-base h-full rounded-lg p-5">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
              <span class="rounded-full border border-[var(--gp-ink-200)] px-3 py-1 text-[length:var(--text-caption)] font-medium text-brand-primary">
                {section.label}
              </span>
              <span class="text-[length:var(--text-caption)] text-brand-muted">
                {section.totalCount} {section.totalCount === 1 ? "tool" : "tools"}
              </span>
            </div>
            <h3 class="font-heading text-[length:var(--text-subheading)] font-bold text-brand-text">
              {section.heading}
            </h3>
            <p class="mt-3 text-[length:var(--text-body)] leading-7 text-brand-muted">
              {section.description}
            </p>
            <div class="mt-5 grid gap-3">
              {section.items.map((item) => (
                <a
                  href={item.href}
                  class="rounded-lg border border-[var(--gp-ink-100)] bg-[var(--gp-paper)] p-3 no-underline transition-[border-color,background-color,color] hover:border-[var(--gp-emerald-200)] hover:bg-[var(--gp-paper-2)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
                >
                  <span class="block font-heading text-[length:var(--text-body)] font-bold leading-snug text-brand-text">
                    {item.title}
                  </span>
                  {item.metadata?.timeEstimate && (
                    <span class="mt-1 block text-[length:var(--text-caption)] text-brand-muted">
                      {item.metadata.timeEstimate}
                    </span>
                  )}
                </a>
              ))}
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              <a class="gp-filter-chip" href={`${section.nextStepHref}/`}>
                {section.nextStepLabel}
              </a>
              {section.overflowCount > 0 && (
                <span class="gp-filter-chip" aria-label={`${section.overflowCount} more free tools in this stage`}>
                  {section.overflowCount} more
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </section>

  <section slot="cta" id="signup" class="mt-8 border-t border-neutral-200 py-10 text-center">
    <p class="editorial-kicker mb-3 justify-center">Free trial</p>
    <h2 class="font-heading mb-2 text-2xl font-bold text-brand-text">
      Try GrantPipe while you use the download.
    </h2>
    <p class="mx-auto mb-6 max-w-md text-brand-muted">
      Use the free resource first. Then try the same workflow in GrantPipe.
    </p>
    <PublicSignupCta
      client:load
      sourcePage="/free"
      buttonText={siteConfig.funnel.bofu.ctaText}
    />
  </section>
</CategoryHub>
