---
import "../styles/global.css";
import BaseLayout from "@grantpipe/ui/site/layouts/base-layout.astro";
import { ExitIntentPopup } from "@grantpipe/ui/site/components/exit-intent-popup";
import { resolveExitPopupProps } from "@grantpipe/ui/site/lib/exit-popup-props";
import { getPublicApiBaseUrl } from "@grantpipe/ui/site/lib/public-api-url";
import type { LeadMagnetOffer } from "@grantpipe/ui/site";
import type { LeadMagnetSlug } from "@grantpipe/shared";
import Button from "@/components/ui/button.astro";
import ExplainerVideo from "@/components/explainer-video.astro";
import ProductSurface from "@/components/product-surface.astro";
import { getSignupCtaTarget, siteConfig } from "@/config/site";
import { getImage } from "astro:assets";
import grantpipeGrantsSrc from "@/assets/grantpipe-grants.png";

type IconName =
  | "audit"
  | "balance"
  | "calendar"
  | "check"
  | "evidence"
  | "ledger"
  | "report"
  | "transfer";

export interface PaidLandingPageData {
  slug: string;
  title: string;
  description: string;
  kicker: string;
  headline: string;
  subhead: string;
  primaryCta: string;
  exitLeadMagnet: LeadMagnetOffer & { slug: LeadMagnetSlug };
  trust: string;
  proofCard: {
    label: string;
    status: string;
    rows: Array<{ label: string; value: string }>;
    progressLabel: string;
    progress: string;
  };
  painsTitle: string;
  pains: string[];
  workflowTitle: string;
  workflowSteps: Array<{ icon: IconName; heading: string; copy: string }>;
  featureTitle: string;
  features: Array<{ icon: IconName; heading: string; copy: string }>;
  proofTitle: string;
  proofPoints: Array<{ value: string; label: string; source: string }>;
  trustLabels: string[];
  faqTitle: string;
  faqs: Array<{ q: string; a: string }>;
  finalTitle: string;
  finalBody: string;
}

interface Props {
  page: PaidLandingPageData;
}

const { page } = Astro.props;
const canonicalUrl = `https://${siteConfig.domain}/lp/${page.slug}/`;
const signupHref = getSignupCtaTarget();
const exitPopupProps =
  siteConfig.exitPopup?.enabled !== false ? resolveExitPopupProps(siteConfig) : undefined;
const publicApiUrl = getPublicApiBaseUrl();
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: page.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

const heroImageAvif = await getImage({
  src: grantpipeGrantsSrc,
  format: "avif",
  widths: [480, 768, 1280],
  sizes: "(max-width: 899px) 100vw, 56vw",
});

const heroImageWebp = await getImage({
  src: grantpipeGrantsSrc,
  format: "webp",
  widths: [480, 768, 1280],
  sizes: "(max-width: 899px) 100vw, 56vw",
});

const heroImageFallback = await getImage({
  src: grantpipeGrantsSrc,
  format: "png",
  width: 1280,
});

const productModules: Array<{ label: string; meta: string }> = [
  { label: "Grants", meta: "Award record" },
  { label: "Funds", meta: "Restricted balances" },
  { label: "Deadlines", meta: "Calendar + owners" },
  { label: "Reports", meta: "SF-425, SEFA, foundation" },
  { label: "Evidence", meta: "Documents + approvals" },
  { label: "Drawdowns", meta: "Drawn vs. spent" },
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonicalUrl={canonicalUrl}
  siteName={siteConfig.name}
  ogType="website"
  twitterSite={siteConfig.social?.twitterHandle}
  theme={siteConfig.theme}
  fonts={siteConfig.theme.fonts}
  themeColor={siteConfig.theme.primary}
  appleTouchIcon={siteConfig.appleTouchIcon}
  showFooter={false}
  noindex={true}
  siteUrl={`https://${siteConfig.domain}`}
  siteLogo={siteConfig.logo?.light ? `https://${siteConfig.domain}${siteConfig.logo.light}` : undefined}
  siteFounder={siteConfig.author}
  siteSameAs={siteConfig.sameAs}
  enableScrollReveal={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/<\//g, "<\\/")} is:inline />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      href={heroImageAvif.src}
      imagesrcset={heroImageAvif.srcSet.attribute}
      imagesizes="(max-width: 899px) 100vw, 56vw"
      fetchpriority="high"
    />
  </Fragment>

  <header slot="header" class="lp-header">
    <a href="#main-content" class="lp-skip-link">Skip to main content</a>
    <div class="lp-shell lp-header-inner">
      <a class="lp-header-logo" href="/" aria-label="GrantPipe home">
        <img class="lp-logo-img" src={siteConfig.logo?.light} alt="GrantPipe" width="150" height="32" />
      </a>
      <Button
        variant="primary"
        size="lg"
        href={signupHref}
        class="lp-header-cta"
        data-preserve-utm
        data-cta-button
        data-cta-placement={`lp-${page.slug}-header-primary`}
        data-cta-section="header"
        data-cta-intent="convert"
      >
        <span class="lp-cta-short">Start free trial</span><span class="lp-cta-long">Start 1-month free trial</span>
      </Button>
    </div>
  </header>

  <div class="lp-page" data-lp-slug={page.slug}>
    <section class="lp-hero" aria-labelledby="hero-title" data-section-impression="hero">
      <div class="lp-shell lp-hero-grid">
        <div class="lp-hero-copy">
          <p class="lp-kicker">{page.kicker}</p>
          <h1 id="hero-title">{page.headline}</h1>
          <p class="lp-subhead">{page.subhead}</p>
          <ul class="lp-hero-trust-labels" aria-label="Trust indicators">
            {page.trustLabels.map((label) => (
              <li>{label}</li>
            ))}
          </ul>
          <div class="lp-actions lp-hero-actions">
            <Button
              variant="primary"
              size="lg"
              href={signupHref}
              data-preserve-utm
              data-cta-button
              data-cta-placement={`lp-${page.slug}-hero-primary`}
              data-cta-section="hero"
              data-cta-intent="convert"
            >
              {page.primaryCta}
            </Button>
            <p class="lp-microtrust">Free for 1 month. No card. Cancel anytime.</p>
          </div>
          <p class="lp-trust">{page.trust}</p>
          <a
            href="#workflow-title"
            class="lp-anchor-link"
            data-cta-button
            data-cta-placement={`lp-${page.slug}-hero-scroll`}
            data-cta-section="hero"
            data-cta-intent="explore-anchor"
          >See how it works <span aria-hidden="true">&#8595;</span></a>
        </div>

        <aside class="lp-dashboard-stage" aria-label={page.proofCard.label}>
          <div class="lp-dashboard-frame">
            <div class="lp-dashboard-toolbar" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <picture>
              <source type="image/avif" srcset={heroImageAvif.srcSet.attribute} sizes="(max-width: 899px) 100vw, 56vw" />
              <source type="image/webp" srcset={heroImageWebp.srcSet.attribute} sizes="(max-width: 899px) 100vw, 56vw" />
              <img
                src={heroImageFallback.src}
                alt="GrantPipe grant dashboard showing award status, deadlines, and grant records"
                width="1280"
                height="720"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
          <div class="lp-proof-stack">
            <div class="lp-proof-card">
              <div class="lp-proof-card-header">
                <span>{page.proofCard.label}</span>
                <strong>{page.proofCard.status}</strong>
              </div>
              {page.proofCard.rows.map((row) => (
                <div class="lp-mini-row">
                  <span>{row.label}</span>
                  <strong>{row.value}</strong>
                </div>
              ))}
              <div class="lp-progress" aria-label={page.proofCard.progressLabel}>
                <span class="lp-progress-fill" style={`width: ${page.proofCard.progress}`}></span>
              </div>
            </div>
            <div class="lp-proof-note">
              <strong>Trial setup path</strong>
              <span>Import tracker</span>
              <span>Map deadlines</span>
              <span>Invite finance</span>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <ExplainerVideo
      eyebrow="Product overview"
      title="See how GrantPipe keeps grants, funds, and reports connected."
      body="Watch the workspace flow from award setup to reporting evidence, then start with the live grant creating the most deadline pressure."
      ctaHref={signupHref}
      ctaLabel="Start 1-month free trial"
      preserveUtm={true}
      ctaPlacement={`lp-${page.slug}-explainer-primary`}
      ctaSection="explainer"
      ctaIntent="convert"
      variant="landing"
    />

    <section class="lp-section lp-problem" aria-labelledby="problem-title" data-section-impression="problem">
      <div class="lp-shell">
        <h2 id="problem-title">{page.painsTitle}</h2>
        <hr class="gp-hairline--accent lp-problem-hairline" />
        <ul class="lp-pain-list">
          {page.pains.map((pain) => (
            <li>
              <span aria-hidden="true"></span>
              <p>{pain}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="lp-section" aria-labelledby="workflow-title" data-section-impression="workflow">
      <div class="lp-shell">
        <div class="lp-section-heading">
          <p class="gp-kicker--accent">Workflow</p>
          <h2 id="workflow-title">{page.workflowTitle}</h2>
        </div>
        <div class="gp-step-band lp-workflow-list">
          {page.workflowSteps.map((step) => (
            <article class="lp-workflow-step gp-step">
              <div class={`lp-icon lp-icon-${step.icon}`} aria-hidden="true"></div>
              <h3>{step.heading}</h3>
              <p>{step.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-product-section" aria-labelledby="product-title" data-section-impression="product">
      <div class="lp-shell lp-product-grid">
        <div class="lp-section-heading">
          <p class="lp-kicker">Product view</p>
          <h2 id="product-title">A grant record your whole team can inspect.</h2>
          <p class="lp-product-copy">
            Paid clicks should land on the actual workflow: grants, deadlines, restricted funds, reports, and evidence in one workspace.
          </p>
          <Button
            variant="primary"
            size="lg"
            href={signupHref}
            data-preserve-utm
            data-cta-button
            data-cta-placement={`lp-${page.slug}-product-primary`}
            data-cta-section="product"
            data-cta-intent="convert"
          >
            Start 1-month free trial
          </Button>
        </div>
        <div class="lp-product-modules" aria-label="What's inside the workspace">
          <p class="lp-product-modules-title">What's inside</p>
          <ProductSurface
            label="Workspace modules"
            variant="rows"
            items={productModules.map((mod) => ({ label: mod.label, value: mod.meta }))}
          />
        </div>
      </div>
    </section>

    <section class="lp-section lp-split-section" aria-labelledby="features-title" data-section-impression="features">
      <div class="lp-shell gp-feature-split lp-split-grid">
        <div class="gp-feature-split__body">
          <div class="lp-section-heading">
            <p class="gp-kicker--accent">What GrantPipe adds</p>
            <h2 id="features-title">{page.featureTitle}</h2>
          </div>
          <div class="lp-feature-list">
            {page.features.map((feature) => (
              <article class="lp-feature">
                <div class={`lp-icon lp-icon-${feature.icon}`} aria-hidden="true"></div>
                <div>
                  <h3>{feature.heading}</h3>
                  <p>{feature.copy}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
        <div class="gp-feature-split__media">
          <ProductSurface
            label="Grant controls"
            variant="rows"
            items={page.features.map((feature) => ({ label: feature.heading, status: "Live" }))}
          />
        </div>
      </div>
    </section>

    <section class="lp-proof-section gp-proof-band" aria-labelledby="proof-title" data-section-impression="proof">
      <div class="lp-shell">
        <div class="lp-section-heading">
          <p class="gp-kicker--accent">Why it matters</p>
          <h2 id="proof-title">{page.proofTitle}</h2>
        </div>
        <ul class="lp-stat-list gp-proof-band__grid">
          {page.proofPoints.map((point) => (
            <li class="lp-stat gp-proof-stat">
              <strong class="gp-proof-stat__value">{point.value}</strong>
              <p class="lp-stat-label gp-proof-stat__label">{point.label}</p>
              <p class="lp-stat-source">{point.source}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="lp-trust-band" aria-label="Compliance and accountability" data-section-impression="trust">
      <div class="lp-shell lp-trust-band-inner">
        <p class="lp-trust-built">Public pricing. Compliance-ready. Staff-led setup.</p>
      </div>
    </section>

    <section class="lp-section lp-faq" aria-labelledby="faq-title" data-section-impression="faq">
      <div class="lp-shell">
        <div class="lp-section-heading">
          <p class="lp-kicker">Common questions</p>
          <h2 id="faq-title">{page.faqTitle}</h2>
        </div>
        <div class="lp-faq-list">
          {page.faqs.map((faq) => (
            <details class="lp-faq-item" data-lp-faq-item>
              <summary class="lp-faq-q">{faq.q}</summary>
              <div class="lp-faq-a">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-final gp-section--emerald" aria-labelledby="final-title" data-section-impression="final">
      <div class="lp-shell">
        <p class="gp-kicker--accent">Start with one live award</p>
        <h2 id="final-title">{page.finalTitle}</h2>
        <p class="lp-final-body">{page.finalBody}</p>
        <div class="lp-actions">
          <Button
            variant="primary"
            size="lg"
            href={signupHref}
            data-preserve-utm
            data-cta-button
            data-cta-placement={`lp-${page.slug}-final-primary`}
            data-cta-section="final"
            data-cta-intent="convert"
          >
            {page.primaryCta}
          </Button>
          <a
            href="#hero-title"
            class="lp-anchor-link"
            data-cta-button
            data-cta-placement={`lp-${page.slug}-final-scroll`}
            data-cta-section="final"
            data-cta-intent="explore-anchor"
          >See how it works <span aria-hidden="true">&#8593;</span></a>
        </div>
        <p class="lp-trust">{page.trust}</p>
      </div>
    </section>

    <footer class="lp-footer">
      <div class="lp-shell lp-footer-inner">
        <div class="lp-footer-logo">
          <img class="lp-logo-img" src={siteConfig.logo?.light} alt="GrantPipe" width="150" height="32" loading="lazy" />
        </div>
        <p class="lp-footer-trust">Built by Angel Campa, Principal SDET. Public pricing.</p>
        <nav aria-label="Legal">
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </nav>
      </div>
    </footer>
  </div>

  <div class="lp-mobile-cta" data-mobile-sticky>
    <Button
      variant="primary"
      size="lg"
      href={signupHref}
      data-preserve-utm
      data-cta-button
      data-cta-placement={`lp-${page.slug}-mobile-sticky-primary`}
      data-cta-section="mobile-sticky"
      data-cta-intent="convert"
    >
      {page.primaryCta}
    </Button>
    <p class="lp-mobile-cta-note">Free for 1 month. No card.</p>
  </div>

  {exitPopupProps && (
    <ExitIntentPopup
      client:load
      apiUrl={publicApiUrl}
      leadMagnet={page.exitLeadMagnet}
      {...exitPopupProps}
    />
  )}

  <script is:inline>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const attributionKeys = [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_term",
        "msclkid",
        "gclid",
      ];
      const MAX_VAL_LENGTH = 256;
      const attribution = attributionKeys
        .map((key) => {
          const value = params.get(key);
          if (!value) return null;
          return [key, value.slice(0, MAX_VAL_LENGTH)];
        })
        .filter(Boolean);

      if (attribution.length > 0) {
        document.querySelectorAll("[data-preserve-utm]").forEach((link) => {
          const href = link.getAttribute("href");
          if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:")) {
            return;
          }
          try {
            const url = new URL(href, window.location.origin);
            attribution.forEach(([key, value]) => url.searchParams.set(key, value));
            link.setAttribute("href", url.toString());
          } catch {
            // Leave malformed hrefs unchanged.
          }
        });
      }

      const sticky = document.querySelector("[data-mobile-sticky]");
      const stickyLink = sticky?.querySelector("a");
      const heroConvertCtas = document.querySelectorAll(
        '[data-cta-section="hero"][data-cta-intent="convert"]:not([data-cta-section="header"]):not([data-cta-section="mobile-sticky"])',
      );

      const setStickyHidden = (hidden) => {
        if (!sticky || !stickyLink) return;
        sticky.classList.toggle("is-hidden", hidden);
        sticky.setAttribute("aria-hidden", hidden ? "true" : "false");
        stickyLink.setAttribute("tabindex", hidden ? "-1" : "0");
      };

      if (sticky && heroConvertCtas.length > 0 && "IntersectionObserver" in window) {
        const visibleCtas = new Set();
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) visibleCtas.add(entry.target);
              else visibleCtas.delete(entry.target);
            });
            setStickyHidden(visibleCtas.size > 0);
          },
          { threshold: 0.1 },
        );
        heroConvertCtas.forEach((cta) => observer.observe(cta));
      } else {
        setStickyHidden(false);
      }

      // FAQ open state: open all on >=640px, open first item on mobile
      const faqItems = document.querySelectorAll("[data-lp-faq-item]");
      const openFaqs = () => {
        const isWide = window.matchMedia("(min-width: 640px)").matches;
        faqItems.forEach((item, index) => {
          if (isWide) {
            item.setAttribute("open", "");
          } else if (index === 0) {
            item.setAttribute("open", "");
          } else {
            item.removeAttribute("open");
          }
        });
      };
      openFaqs();
      const mql = window.matchMedia("(min-width: 640px)");
      mql.addEventListener("change", openFaqs);

      // Section impression tracking
      const sectionsToTrack = document.querySelectorAll("[data-section-impression]");
      const seen = new Set();
      const lpSlug = document.querySelector("[data-lp-slug]")?.getAttribute("data-lp-slug") || "";
      if (sectionsToTrack.length && "IntersectionObserver" in window) {
        const sectionObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const section = entry.target.getAttribute("data-section-impression");
            if (entry.isIntersecting && !seen.has(section)) {
              seen.add(section);
              try {
                if (typeof window.posthog?.capture === "function") {
                  window.posthog.capture("lp_section_view", { section, slug: lpSlug });
                }
              } catch {}
            }
          });
        }, { threshold: 0.35 });
        sectionsToTrack.forEach((s) => sectionObserver.observe(s));
      }
    })();
  </script>
</BaseLayout>

<style>
  :global(html) {
    --paid-lp-mobile-sticky-offset: 0px;
    scroll-padding-top: clamp(4.5rem, 4.5rem + 1vw, 6rem);
  }

  :global(body) {
    background:
      linear-gradient(180deg, var(--surface-secondary) 0%, var(--surface-primary) 38rem),
      var(--surface-primary);
  }

  :global(body #ventora-ai-sdr-root) {
    z-index: 70;
  }

  .lp-page {
    color: var(--color-brand-text);
  }

  .lp-skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    min-height: 48px;
    padding: 0.7rem 1rem;
    background: var(--color-primary-800);
    color: var(--color-neutral-50);
    font-weight: 700;
    border-radius: 0 0 var(--radius-xs) 0;
  }

  .lp-skip-link:focus {
    left: 0;
  }

  .lp-mobile-cta {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 60;
    display: none;
    padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--gp-ink-200);
    background: var(--gp-paper);
    backdrop-filter: blur(16px);
    transform: translateY(0);
    transition:
      transform 220ms ease,
      opacity 220ms ease;
  }

  .lp-mobile-cta.is-hidden {
    transform: translateY(110%);
    opacity: 0;
    pointer-events: none;
  }

  .lp-mobile-cta-note {
    margin-top: 0.35rem;
    color: var(--color-neutral-600);
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: center;
    white-space: nowrap;
  }

  .lp-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--gp-paper);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--gp-ink-200);
  }

  .lp-header-inner,
  .lp-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
  }

  .lp-header-logo,
  .lp-footer-logo {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
  }

  .lp-logo-img {
    display: block;
    height: 1.7rem;
    width: auto;
  }

  .lp-shell {
    width: min(100% - 2rem, 70rem);
    margin-inline: auto;
  }

  /* Header CTA responsive text */
  .lp-cta-short {
    display: none;
  }

  .lp-cta-long {
    display: inline;
  }

  .lp-hero {
    padding: clamp(2.25rem, 8vw, 6rem) 0 clamp(2.5rem, 6vw, 4.5rem);
  }

  .lp-hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .lp-hero-copy {
    max-width: 43rem;
  }

  .lp-kicker {
    margin: 0;
    color: var(--gp-emerald-700);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-block: 0;
  }

  h1 {
    margin-top: 1rem;
    max-width: 18ch;
    font-family: var(--font-heading);
    font-size: clamp(2.35rem, 7vw, 4.25rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 0.98;
  }

  .lp-subhead {
    margin-top: 1.4rem;
    max-width: 39rem;
