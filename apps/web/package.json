{
  "name": "@grantpipe/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "ai-cs:validate-knowledge": "tsx scripts/validate-ai-cs-knowledge.ts",
    "build": "tsx scripts/validate-ai-cs-knowledge.ts && vite build && node scripts/verify-build-analytics.mjs",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "preview": "vite preview",
    "verify:headers": "node scripts/verify-build-headers.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --maxWorkers=1 --pool=forks --no-file-parallelism",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --pool=forks --no-file-parallelism && node scripts/verify-coverage-thresholds.mjs"
  },
  "dependencies": {
    "@grantpipe/api": "workspace:*",
    "@grantpipe/shared": "workspace:*",
    "@grantpipe/ui": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/react": "^10.49.0",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "@testing-library/user-event": "^14.6.1",
    "@ventora/ai-cs": "1.0.0",
    "better-auth": "^1.6.0",
    "dompurify": "^3.3.3",
    "hono": "^4",
    "lucide-react": "^0.511",
    "posthog-js": "^1.369.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@adobe/css-tools": "^4.4.4",
    "@sentry/vite-plugin": "^4.7.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-router-devtools": "^1",
    "@tanstack/router-plugin": "^1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^3",
    "happy-dom": "^20.8.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3",
    "wrangler": "^4"
  }
}
