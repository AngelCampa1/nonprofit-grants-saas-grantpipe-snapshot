# PostHog analytics — uses the bundled default key if unset
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry browser error monitoring (leave blank to disable)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=

# Microsoft Advertising UET tag ID for Bing Ads conversion tracking
# Falls back to the bundled production tag (343248795) if unset
VITE_BING_UET_ID=

# Ventora CRM feedback widget — CRM-issued public key for this product.
# Leave blank to disable the widget entirely (no script is injected).
# Obtain from the CRM admin dashboard under Products > grantpipe > Widget Key.
VITE_CRM_WIDGET_KEY=

# Ventora CRM loader URL — defaults to https://crm.ventoralabs.com/w/v1.js when unset.
# Only override this for local CRM development; leave blank in production.
VITE_CRM_LOADER_URL=
