{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grantpipe-web",
  "compatibility_date": "2026-05-06",
  "workers_dev": false,
  "routes": [{ "pattern": "app.grantpipe.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "vars": {
    "VITE_POSTHOG_KEY": "phc_examplePostHogProjectKey0000000000000000",
    "VITE_POSTHOG_HOST": "https://us.i.posthog.com",
  },
}
