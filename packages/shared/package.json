{
  "name": "@grantpipe/shared",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./knowledge": "./src/knowledge/index.ts",
    "./public-kb": "./src/public-kb/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run knowledge:generate && tsx src/public-kb/export-json.ts",
    "knowledge:generate": "tsx scripts/knowledge/generate.ts",
    "knowledge:check": "tsx scripts/knowledge/generate.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3",
    "typescript": "^5",
    "vitest": "^3"
  }
}
