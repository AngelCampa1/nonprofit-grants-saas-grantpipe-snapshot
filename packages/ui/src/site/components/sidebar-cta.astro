---
import { buildCtaAnalyticsAttributes } from "../lib/cta-analytics"
import type { CtaAnalyticsContext } from "../types"

interface Props {
  ctaText: string
  ctaTarget: string
  subtitle?: string
  bullets?: string[]
  trustNote?: string
  analytics?: CtaAnalyticsContext
}

const { ctaText, ctaTarget, subtitle, bullets, trustNote, analytics } = Astro.props
const analyticsAttributes = buildCtaAnalyticsAttributes({
  ...analytics,
  target: ctaTarget,
})
---

<aside class="hidden lg:block sticky top-24" data-section="sidebar-cta" aria-label="Get started">
  <div data-sidebar-cta-panel class="editorial-panel editorial-panel--soft p-6">
    {subtitle && (
      <p class="editorial-kicker mb-4">{subtitle}</p>
    )}
    {bullets && bullets.length > 0 && (
      <ul class="space-y-2 mb-5 list-none p-0">
        {bullets.map((bullet) => (
          <li class="flex items-start gap-2 text-[length:var(--text-caption)] leading-6 text-brand-muted">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-brand-primary" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
              <path fill-rule="evenodd" d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
            </svg>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    )}
    <a
      href={ctaTarget}
      class="gp-mkt-btn primary md flex w-full items-center justify-center no-underline"
      {...analyticsAttributes}
    >
      {ctaText}
    </a>
    {trustNote && (
      <p class="mt-3 text-[length:var(--text-caption)] leading-6 text-brand-muted">{trustNote}</p>
    )}
  </div>
</aside>
