---
interface Props {
  eyebrow?: string
  message: string
  ctaText?: string
  ctaHref?: string
  endsAt?: string
  dismissible?: boolean
  storageKey?: string
  ariaLabel?: string
}

const {
  eyebrow,
  message,
  ctaText,
  ctaHref,
  endsAt,
  dismissible = true,
  storageKey,
  ariaLabel = "Promotional announcement",
} = Astro.props

if (!message) {
  return Astro.slots.render("default")
}

const resolvedStorageKey = storageKey ?? (endsAt ? `promo-banner:${endsAt}` : "promo-banner:default")
const showCta = Boolean(ctaText && ctaHref)
---

<div
  data-promo-banner
  data-promo-ends-at={endsAt}
  data-promo-storage-key={resolvedStorageKey}
  role="region"
  aria-label={ariaLabel}
  hidden
  class="promo-banner relative w-full bg-brand-primary text-neutral-50"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6">
    <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-1.5 text-sm font-medium sm:flex-nowrap sm:gap-3">
      {eyebrow && (
        <span
          class="inline-flex shrink-0 rounded-full border border-white/30 bg-white/10 px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-neutral-50"
        >
          {eyebrow}
        </span>
      )}
      <span class="min-w-0 basis-full sm:basis-auto">{message}</span>
      {endsAt && (
        <span
          data-promo-countdown
          class="inline-flex shrink-0 rounded-full bg-white/10 border border-white/20 px-2 py-0.5 font-mono text-[10px] font-semibold tracking-wide text-neutral-50/90"
        ></span>
      )}
      {showCta && (
        <a
          href={ctaHref}
          class="hidden shrink-0 items-center rounded-full border border-white/40 px-3 py-1 text-xs font-semibold text-neutral-50 no-underline transition-colors duration-[var(--transition-fast)] hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-emerald-700)] sm:inline-flex"
          data-promo-banner-cta
        >
          {ctaText}
        </a>
      )}
    </div>
    {dismissible && (
      <button
        type="button"
        data-promo-banner-dismiss
        aria-label="Dismiss promotional banner"
        class="-mr-1 inline-flex min-h-12 min-w-12 shrink-0 cursor-pointer items-center justify-center rounded-full text-neutral-50/80 transition-colors duration-[var(--transition-fast)] hover:bg-white/10 hover:text-neutral-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-emerald-700)]"
      >
        <svg
          class="h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    )}
  </div>
</div>

<noscript><style>[data-promo-banner]{display:block}</style></noscript>
<script is:inline>
  (function () {
    var nodes = document.querySelectorAll("[data-promo-banner]");
    if (!nodes.length) return;
    nodes.forEach(function (node) {
      var endsAt = node.getAttribute("data-promo-ends-at");
      var storageKey = node.getAttribute("data-promo-storage-key");
      var expired = false;
      if (endsAt) {
        var expiry = Date.parse(endsAt);
        if (!isNaN(expiry) && Date.now() > expiry) {
          expired = true;
        }
      }
      var dismissed = false;
      try {
        if (storageKey && window.localStorage.getItem(storageKey) === "dismissed") {
          dismissed = true;
        }
      } catch (err) {
        dismissed = false;
      }
      if (expired || dismissed) {
        node.hidden = true;
        return;
      }
      node.hidden = false;
      try {
        var promoSlug = "site-promo-banner";
        window.posthog && window.posthog.capture && window.posthog.capture("promo_banner_viewed", { promo_slug: promoSlug });
      } catch (e) {
        /* analytics best-effort */
      }
      var btn = node.querySelector("[data-promo-banner-dismiss]");
      if (btn) {
        btn.addEventListener("click", function () {
          node.hidden = true;
          try {
            if (storageKey) {
              window.localStorage.setItem(storageKey, "dismissed");
            }
          } catch (err) {
            /* localStorage unavailable - dismiss for this view only */
          }
        });
      }
      var countdownEl = node.querySelector("[data-promo-countdown]");
      if (countdownEl && endsAt) {
        var expiry = Date.parse(endsAt);
        function formatCountdown(ms) {
          if (ms <= 0) return null;
          var totalMinutes = Math.floor(ms / 60000);
          var days = Math.floor(totalMinutes / 1440);
          var hours = Math.floor((totalMinutes % 1440) / 60);
          var minutes = totalMinutes % 60;
          if (ms < 60000) {
            return "Ends in 1m";
          }
          if (days >= 1) {
            return "Ends in " + days + "d " + hours + "h " + minutes + "m";
          }
          if (hours >= 1) {
            return "Ends in " + hours + "h " + minutes + "m";
          }
          return "Ends in " + minutes + "m";
        }
        function tick() {
          var remaining = expiry - Date.now();
          if (remaining <= 0) {
            clearInterval(intervalId);
            // Expiry just hides the banner. Do not write the dismissal storageKey here,
            // or a future promo that reuses the same key would start pre-dismissed.
            node.hidden = true;
            return;
          }
          var text = formatCountdown(remaining);
          if (text) {
            countdownEl.textContent = text;
          }
        }
        tick();
        var intervalId = setInterval(tick, 1000);
      }
    });
  })();
</script>
