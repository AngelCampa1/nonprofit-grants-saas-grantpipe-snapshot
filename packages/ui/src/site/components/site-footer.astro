---
import { EmailCapture } from "./email-capture"
import { getCurrentYear } from "../lib/dates"
import type { SurveyQualificationConfig, SurveyQuestion } from "../types"

interface EmailCaptureConfig {
  mode?: "capture" | "cta"
  heading?: string
  ctaText?: string
  ctaTarget?: string
  buttonText?: string
  apiUrl: string
  sourcePage: string
  surveyQuestions: SurveyQuestion[]
  surveyQualification?: SurveyQualificationConfig
  qualification?: SurveyQualificationConfig
  discoveryCallUrl: string
  privacyNote?: string
  errorInvalidEmail?: string
  errorDuplicate?: string
  errorGeneric?: string
  successMessage?: string
  surveyPreview?: string
  subtitle?: string
  whatHappensNext?: string
  qualifiedHeading?: string
  qualifiedBody?: string
  qualifiedCtaText?: string
  qualifiedDismissText?: string
  unqualifiedHeading?: string
  unqualifiedBody?: string
  unqualifiedCtaText?: string
  unqualifiedCtaTarget?: string
  unqualifiedDismissText?: string
}

interface Props {
  siteName: string
  tagline?: string
  linkGroups?: { heading: string; links: { label: string; href: string }[] }[]
  legalLinks?: { label: string; href: string }[]
  emailCapture?: EmailCaptureConfig
  footerTextColor?: string
  copyrightSuffix?: string
  contactEmail?: string
  captureVariant?: "full" | "compact" | "none"
  logoLight?: string
  currentPath?: string
}

const {
  siteName,
  tagline,
  linkGroups = [],
  legalLinks = [],
  emailCapture,
  footerTextColor = "var(--color-brand-text)",
  copyrightSuffix = "All rights reserved.",
  contactEmail,
  captureVariant = "full",
  logoLight,
  currentPath,
} = Astro.props

function normalizePath(value: string | undefined): string | undefined {
  if (typeof value !== "string" || value.length === 0) return undefined
  if (value === "/") return "/"
  return value.endsWith("/") ? value.slice(0, -1) : value
}

const normalizedCurrentPath = normalizePath(currentPath)

function isActiveFooterHref(href: string): boolean {
  if (!normalizedCurrentPath) return false
  const normalized = normalizePath(href)
  return normalized !== undefined && normalized === normalizedCurrentPath
}

const currentYear = getCurrentYear()
const showEmailCapture = Boolean(emailCapture) && captureVariant !== "none"
const showCtaMode =
  emailCapture?.mode === "cta" &&
  Boolean(emailCapture.ctaTarget?.trim()) &&
  Boolean(emailCapture.ctaText?.trim())

if (emailCapture?.mode === "cta" && !showCtaMode) {
  throw new Error("SiteFooter emailCapture CTA mode requires both ctaText and ctaTarget.")
}
---

<footer data-site-footer class="site-footer relative border-t border-[var(--gp-ink-200)] bg-surface-secondary pt-[var(--section-py-sm)] pb-[calc(var(--section-py-sm)_+_5rem)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {showEmailCapture && emailCapture && (
      <div class:list={[captureVariant === "compact" ? "mb-10" : "mb-14"]}>
        {captureVariant === "compact" ? (
          <div data-footer-email-capture class="gp-card-base md:flex md:items-start md:justify-between md:gap-10 md:p-8">
            <div class="max-w-[30rem]">
              <p class="editorial-kicker">See the live product path</p>
              {emailCapture.heading && (
                <h3
                  class="mt-4 font-heading text-[length:var(--text-heading)] font-bold leading-[1.04]"
                  style={`color: ${footerTextColor}`}
                >
                  {emailCapture.heading}
                </h3>
              )}
              {emailCapture.subtitle && (
                <p class="mt-3 max-w-[28rem] text-[length:var(--text-body)] leading-7 text-brand-muted">
                  {emailCapture.subtitle}
                </p>
              )}
            </div>
            <div class="mt-6 md:mt-0 md:min-w-[21rem] md:flex-1">
              {showCtaMode ? (
                <a
                  href={emailCapture.ctaTarget}
                  class="btn-primary inline-flex w-full items-center justify-center sm:w-auto sm:min-w-[16rem]"
                >
                  {emailCapture.ctaText}
                </a>
              ) : (
                <EmailCapture
                  client:visible
                  apiUrl={emailCapture.apiUrl}
                  sourcePage={emailCapture.sourcePage}
                  surveyQuestions={emailCapture.surveyQuestions}
                  surveyQualification={emailCapture.qualification ?? emailCapture.surveyQualification}
                  qualification={emailCapture.qualification ?? emailCapture.surveyQualification}
                  discoveryCallUrl={emailCapture.discoveryCallUrl}
                  buttonText={emailCapture.buttonText}
                  privacyNote={emailCapture.privacyNote}
                  errorInvalidEmail={emailCapture.errorInvalidEmail}
                  errorDuplicate={emailCapture.errorDuplicate}
                  errorGeneric={emailCapture.errorGeneric}
                  successMessage={emailCapture.successMessage}
                  surveyPreview={emailCapture.surveyPreview}
                  subtitle={undefined}
                  whatHappensNext={emailCapture.whatHappensNext}
                  qualifiedHeading={emailCapture.qualifiedHeading}
                  qualifiedBody={emailCapture.qualifiedBody}
                  qualifiedCtaText={emailCapture.qualifiedCtaText}
                  qualifiedDismissText={emailCapture.qualifiedDismissText}
                  unqualifiedHeading={emailCapture.unqualifiedHeading}
                  unqualifiedBody={emailCapture.unqualifiedBody}
                  unqualifiedCtaText={emailCapture.unqualifiedCtaText}
                  unqualifiedCtaTarget={emailCapture.unqualifiedCtaTarget}
                  unqualifiedDismissText={emailCapture.unqualifiedDismissText}
                />
              )}
            </div>
          </div>
        ) : (
          <div data-footer-email-capture class="gp-card-base px-5 py-6 md:px-8 md:py-8">
            {emailCapture.heading && (
              <h3
                class="mb-4 max-w-[32rem] font-heading text-[length:var(--text-heading)] font-bold leading-[1.04]"
                style={`color: ${footerTextColor}`}
              >
                {emailCapture.heading}
              </h3>
            )}
            {showCtaMode ? (
              <a
                href={emailCapture.ctaTarget}
                class="btn-primary inline-flex items-center justify-center"
              >
                {emailCapture.ctaText}
              </a>
            ) : (
              <EmailCapture
                client:visible
                apiUrl={emailCapture.apiUrl}
                sourcePage={emailCapture.sourcePage}
                surveyQuestions={emailCapture.surveyQuestions}
                surveyQualification={emailCapture.qualification ?? emailCapture.surveyQualification}
                qualification={emailCapture.qualification ?? emailCapture.surveyQualification}
                discoveryCallUrl={emailCapture.discoveryCallUrl}
                buttonText={emailCapture.buttonText}
                privacyNote={emailCapture.privacyNote}
                errorInvalidEmail={emailCapture.errorInvalidEmail}
                errorDuplicate={emailCapture.errorDuplicate}
                errorGeneric={emailCapture.errorGeneric}
                successMessage={emailCapture.successMessage}
                surveyPreview={emailCapture.surveyPreview}
                subtitle={emailCapture.subtitle}
                whatHappensNext={emailCapture.whatHappensNext}
                qualifiedHeading={emailCapture.qualifiedHeading}
                qualifiedBody={emailCapture.qualifiedBody}
                qualifiedCtaText={emailCapture.qualifiedCtaText}
                qualifiedDismissText={emailCapture.qualifiedDismissText}
                unqualifiedHeading={emailCapture.unqualifiedHeading}
                unqualifiedBody={emailCapture.unqualifiedBody}
                unqualifiedCtaText={emailCapture.unqualifiedCtaText}
                unqualifiedCtaTarget={emailCapture.unqualifiedCtaTarget}
                unqualifiedDismissText={emailCapture.unqualifiedDismissText}
              />
            )}
          </div>
        )}
      </div>
    )}

    <div class="mb-10">
      <div data-footer-brand class="mb-10 border-b border-[var(--gp-ink-200)] pb-8 lg:flex lg:items-start lg:justify-between lg:gap-12">
        <div class="max-w-sm">
          <div class="mb-6 inline-flex items-center gap-3">
            {logoLight ? (
              <img
                src={logoLight}
                alt={`${siteName} logo`}
                width="120"
                height="32"
                class="h-8 w-auto"
              />
            ) : (
              <>
                <span class="inline-flex h-2.5 w-2.5 shrink-0 rounded-full bg-accent-400" aria-hidden="true"></span>
                <span class="font-heading text-[1.05rem] font-semibold leading-none tracking-[-0.01em]" style={`color: ${footerTextColor}`}>
                  {siteName}
                </span>
              </>
            )}
          </div>

          {tagline && (
            <p class="max-w-sm text-[length:var(--text-body)] leading-7 text-neutral-600">
              {tagline}
            </p>
          )}
        </div>

        <dl class="mt-8 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:mt-1 lg:max-w-xl lg:flex-1">
          <div>
            <dt class="text-[length:var(--text-caption)] font-medium text-neutral-500">
              Built for
            </dt>
            <dd class="mt-1.5 font-heading text-[length:var(--text-body-lg)] font-semibold text-brand-text">
              Mid-sized nonprofits
            </dd>
          </div>
          <div>
            <dt class="text-[length:var(--text-caption)] font-medium text-neutral-500">
              Outcome
            </dt>
            <dd class="mt-1.5 font-heading text-[length:var(--text-body-lg)] font-semibold text-brand-text">
              Compliance, funds, and evidence in one workflow
            </dd>
          </div>
        </dl>
      </div>

      {linkGroups.length > 0 && (
        <div class="grid gap-x-8 gap-y-2 sm:grid-cols-[repeat(auto-fit,minmax(170px,1fr))]">
          {linkGroups.map((group) => (
            <div data-footer-link-group class="border-t border-[var(--gp-ink-200)] px-1 py-5">
              <h3 class="mb-4 text-[length:var(--text-caption)] font-semibold text-accent-800">
                {group.heading}
              </h3>
              <ul class="m-0 list-none space-y-1 p-0">
                {(group.links ?? []).map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="inline-flex min-h-12 sm:min-h-0 sm:py-1.5 min-w-12 items-center rounded-sm font-body text-[length:var(--text-body-sm)] text-neutral-800 no-underline transition-colors duration-[var(--transition-fast)] hover:text-primary-600 hover:underline underline-offset-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
                      aria-current={isActiveFooterHref(link.href) ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="flex flex-col items-start justify-between gap-4 border-t border-[var(--gp-ink-200)] pt-6 sm:flex-row sm:items-center">
      <p class="font-mono text-[length:var(--text-caption)] text-neutral-500">
        &copy; {currentYear} {siteName}. {copyrightSuffix}
      </p>

      <nav aria-label="Footer links" class="flex flex-wrap items-center gap-4">
        {contactEmail && (
          <a
            href={`mailto:${contactEmail}`}
            class="inline-flex min-h-12 min-w-12 items-center rounded-sm font-mono text-[length:var(--text-caption)] text-neutral-500 no-underline transition-colors duration-[var(--transition-fast)] hover:text-primary-600 hover:underline underline-offset-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
          >
            Contact
          </a>
        )}
        {legalLinks.map((link) => (
          <a
            href={link.href}
            class="inline-flex min-h-12 min-w-12 items-center rounded-sm font-mono text-[length:var(--text-caption)] text-neutral-500 no-underline transition-colors duration-[var(--transition-fast)] hover:text-primary-600 hover:underline underline-offset-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
            aria-current={isActiveFooterHref(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>
