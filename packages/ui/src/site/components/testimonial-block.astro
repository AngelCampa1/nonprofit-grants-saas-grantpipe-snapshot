---
import SchemaMarkup from "../seo/schema-markup.astro"
import { buildReviewSchema } from "../lib/schema-builders"

interface Props {
  quote: string
  name: string
  title?: string
  reviewOf?: string
  rating?: number
}
const { quote, name, title, reviewOf, rating } = Astro.props

const reviewSchema = reviewOf ? buildReviewSchema({ quote, name, title, reviewOf, rating }) : null
---

<figure class="my-[var(--component-gap)] max-w-2xl border-l-2 border-[var(--gp-emerald-600)] pl-6 md:pl-8">
  <blockquote>
    <p class="text-[length:var(--text-body-lg)] leading-relaxed text-brand-text">
      <span aria-hidden="true" class="mr-1 font-heading text-[length:var(--text-heading)] leading-none text-[var(--gp-emerald-600)] align-text-top">&ldquo;</span>{quote}
    </p>
  </blockquote>
  <figcaption class="mt-5 flex flex-col gap-0.5">
    <span class="font-heading font-semibold text-brand-text">{name}</span>
    {title && (
      <span class="text-[length:var(--text-caption)] text-brand-muted">{title}</span>
    )}
  </figcaption>
</figure>
{reviewSchema && <SchemaMarkup schemas={[reviewSchema]} />}
