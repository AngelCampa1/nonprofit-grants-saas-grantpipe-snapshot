---
import { resolvePublicSignupCta } from "../lib/public-signup-cta";

interface Props {
  sourcePage: string;
  buttonText?: string;
  ctaText?: string;
  ctaTarget?: string;
}

const {
  sourcePage,
  buttonText,
  ctaText,
  ctaTarget,
} = Astro.props;

const resolvedCta = resolvePublicSignupCta({
  explicitTarget: ctaTarget,
  explicitText: ctaText ?? buttonText,
});
---

<a
  href={resolvedCta.target}
  class="gp-mkt-btn primary lg"
>
  {resolvedCta.text}
</a>
