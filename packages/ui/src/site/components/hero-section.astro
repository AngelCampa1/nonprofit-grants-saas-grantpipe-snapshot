---
import { CheckIconHidden } from "../lib/icons"

interface Props {
  eyebrow?: string
  headline: string
  subheadline: string
  trustSignal?: string
  benefits?: string[]
  panelEyebrow?: string
  panelNote?: string
  variant?: "default" | "editorial"
}

const {
  eyebrow,
  headline,
  subheadline,
  trustSignal,
  benefits,
  panelEyebrow,
  panelNote,
  variant = "default",
} = Astro.props
---

<section data-hero data-section="hero" class="hero-section relative w-full">

  {variant === "editorial" ? (
    <div data-hero-content class="hero-shell editorial-shell mx-auto max-w-6xl px-4 pb-[var(--section-py-sm)] pt-[var(--section-py)]">
      <div class="editorial-grid editorial-grid--2 gap-y-[var(--component-gap)]">
        <div class="max-w-[var(--content-measure-wide)]">
          {trustSignal && (
            <p data-hero-trust class="editorial-kicker animate-fade-in">{trustSignal}</p>
          )}
          <h1
            data-hero-title
            class="mt-5 font-heading text-[length:var(--text-editorial-title)] font-bold leading-[1.02] text-brand-text animate-fade-in"
            style="letter-spacing: -0.03em"
          >
            {headline}
          </h1>
          <p data-hero-copy class="editorial-lede mt-[var(--component-gap-sm)] animate-slide-up">
            {subheadline}
          </p>
          <div class="mt-[var(--component-gap)]">
            <slot />
          </div>
        </div>

        {benefits && benefits.length > 0 && (
          <div data-hero-benefits class="hero-benefits-panel editorial-panel self-end p-6 md:p-7">
            <p class="font-mono text-[length:var(--text-kicker)] uppercase tracking-[0.16em] text-brand-muted">
              Why teams join early
            </p>
            <ul class="mt-4 list-none space-y-3 p-0">
              {benefits.map((benefit) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 inline-flex h-[var(--icon-md)] w-[var(--icon-md)] flex-shrink-0 items-center justify-center rounded-full bg-accent-500 text-xs font-bold text-neutral-50" aria-hidden="true" set:html={CheckIconHidden} />
                  <span class="text-[length:var(--text-caption)] font-semibold leading-6 text-brand-text">{benefit}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  ) : (
    <div data-hero-content class="hero-shell mx-auto max-w-6xl px-4 pb-[var(--section-py-sm)] pt-[var(--section-py)]">
      <div class="hero-grid grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(19rem,0.8fr)] lg:items-start lg:gap-12">
        <div class="hero-copy max-w-4xl">
          {eyebrow && (
            <p class="font-mono text-[length:var(--text-kicker)] uppercase tracking-[0.22em] text-accent-700">
              {eyebrow}
            </p>
          )}
          <h1
            data-hero-title
            class:list={[
              "font-heading text-[length:var(--text-hero)] font-bold leading-[0.94] text-brand-text animate-fade-in",
              eyebrow ? "mt-5" : "",
            ]}
            style="letter-spacing: -0.03em"
          >
            {headline}
          </h1>
          <p data-hero-copy class="mt-[var(--component-gap-sm)] max-w-[46rem] text-[length:var(--text-body-lg)] leading-8 text-brand-muted animate-slide-up">
            {subheadline}
          </p>
          {benefits && benefits.length > 0 && (
            <ul class="mt-[var(--component-gap)] grid list-none gap-3 p-0 sm:grid-cols-2">
              {benefits.map((benefit) => (
                <li class="flex items-start gap-3 border-t border-neutral-200/60 pt-3">
                  <span class="mt-0.5 inline-flex h-[var(--icon-md)] w-[var(--icon-md)] flex-shrink-0 items-center justify-center rounded-full bg-accent-500 text-xs font-bold text-neutral-50" aria-hidden="true" set:html={CheckIconHidden} />
                  <span class="text-[length:var(--text-caption)] font-semibold leading-6 text-brand-text">{benefit}</span>
                </li>
              ))}
            </ul>
          )}
          {trustSignal && (
            <p data-hero-trust class="mt-6 inline-flex items-center gap-2 rounded-full border border-accent-200 bg-accent-50 px-4 py-2 text-[length:var(--text-caption)] font-medium text-accent-700">
              <span class="inline-flex h-2 w-2 rounded-full bg-accent-500" aria-hidden="true"></span>
              {trustSignal}
            </p>
          )}
        </div>

        <div data-hero-benefits class="hero-benefits-panel gp-card-base p-6 lg:mt-10 lg:sticky lg:top-28">
          {panelEyebrow && (
            <p class="font-mono text-[length:var(--text-kicker)] uppercase tracking-[0.22em] text-brand-muted">
              {panelEyebrow}
            </p>
          )}
          <div class="mt-4 flex flex-wrap gap-3 lg:flex-col">
            <slot />
          </div>
          {panelNote && (
            <p class="mt-5 border-t border-neutral-200/60 pt-4 text-[length:var(--text-caption)] leading-6 text-brand-muted">
              {panelNote}
            </p>
          )}
        </div>
      </div>
    </div>
  )}

</section>
