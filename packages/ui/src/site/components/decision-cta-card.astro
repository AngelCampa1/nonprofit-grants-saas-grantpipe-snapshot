---
import { CheckIconHidden } from "../lib/icons"
import { buildDecisionCtaCardModel } from "../lib/decision-cta-card"
import type { DecisionCtaCardProps } from "../types"

const model = buildDecisionCtaCardModel(Astro.props as DecisionCtaCardProps)
---

<section class="gp-card-base my-10 p-7 md:p-8" data-section="decision-cta-card">
  <div class="flex flex-col gap-6">
    <div class="space-y-3">
      <p class="font-mono text-[length:var(--text-kicker)] uppercase tracking-[0.18em] text-brand-muted">
        Decision support
      </p>
      <h2 class="font-heading text-[length:var(--text-subheading)] font-bold leading-tight text-brand-text">
        {model.heading}
      </h2>
      <p class="text-[length:var(--text-body)] leading-relaxed text-brand-muted">
        {model.subtext}
      </p>
    </div>

    {model.bullets.length > 0 && (
      <ul class="space-y-2 list-none p-0">
        {model.bullets.map((bullet) => (
          <li class="flex items-start gap-2 text-[length:var(--text-caption)] leading-6 text-brand-text">
            <span
              class="mt-0.5 inline-flex h-[var(--icon-md)] w-[var(--icon-md)] shrink-0 items-center justify-center rounded-full bg-accent-500 text-neutral-50"
              aria-hidden="true"
              set:html={CheckIconHidden}
            />
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={model.primaryCta.target}
        class="gp-mkt-btn primary md inline-flex items-center justify-center no-underline"
        {...model.primaryCta.analyticsAttributes}
      >
        {model.primaryCta.text}
      </a>
      {model.secondaryCta && (
        <a
          href={model.secondaryCta.target}
          class="gp-mkt-btn ghost md inline-flex items-center justify-center no-underline"
          {...model.secondaryCta.analyticsAttributes}
        >
          {model.secondaryCta.text}
        </a>
      )}
    </div>
  </div>
</section>
