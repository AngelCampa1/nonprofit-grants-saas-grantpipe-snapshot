---
import type { NavItem, PromoBannerConfig } from "../types"
import { isActiveSiteNavItem } from "../lib/site-nav-active"
import PromoBanner from "./promo-banner.astro"

interface Props {
  siteName: string
  navItems?: NavItem[]
  ctaText: string
  ctaHref: string
  loginHref?: string
  mobileCtaEyebrow?: string
  ctaVariant?: "primary" | "secondary"
  ctaPill?: boolean
  logoLight?: string
  logoWidth?: number
  promoBanner?: PromoBannerConfig
  currentPath?: string
}

const {
  siteName,
  navItems = [],
  ctaText,
  ctaHref,
  loginHref,
  mobileCtaEyebrow = "Start free trial",
  ctaVariant = "secondary",
  ctaPill = false,
  logoLight,
  logoWidth = 120,
  promoBanner,
  currentPath,
} = Astro.props

const ctaPillVariant = ctaVariant === "primary" ? "primary" : "ghost"
const ctaButtonClass = ctaPill ? `gp-mkt-btn ${ctaPillVariant} md` : `btn-${ctaVariant}`

function getMobileNavLinks(navGroup: NonNullable<NavItem["groups"]>[number]) {
  const priorityLinks = navGroup.links.filter((link) => link.mobilePriority)
  return priorityLinks.length > 0 ? priorityLinks : navGroup.links
}
---

<div data-site-sticky-stack class="sticky top-0 z-50" transition:name="site-header-stack">
{promoBanner && promoBanner.message && <PromoBanner {...promoBanner} />}

<header
  id="site-header"
  class="site-header border-b border-[var(--gp-ink-200)] bg-[var(--gp-paper)] px-3 transition-[background-color,border-color] duration-[var(--transition-base)] sm:px-4"
>
  <div class="mx-auto max-w-7xl">
    <div
      data-site-header-inner
      class="site-header-shell flex min-h-[4.75rem] items-center justify-between gap-4 px-1 sm:px-2 lg:px-3"
    >
      <a
        href="/"
        data-site-brand
        class="site-header-brand inline-flex min-h-12 min-w-12 items-center gap-3 rounded-full no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
        aria-label={`${siteName} home`}
      >
        {logoLight ? (
          <img
            src={logoLight}
            alt={`${siteName} logo`}
            width={logoWidth}
            height="32"
            class="h-8 w-auto"
          />
        ) : (
          <>
            {/* Accent glow intentionally stays color-mix; no semantic --gp-* alpha token exists for this glow. */}
            <span
              class="inline-flex h-2.5 w-2.5 shrink-0 rounded-full bg-accent-400 shadow-[0_0_24px_color-mix(in_srgb,var(--color-accent-400)_55%,transparent)]"
              aria-hidden="true"
            ></span>
            <span class="font-heading text-[1.05rem] font-semibold leading-none tracking-[-0.01em] text-brand-text">
              {siteName}
            </span>
          </>
        )}
      </a>

      <nav
        data-site-nav
        data-site-nav-shell
        class="hidden items-center lg:flex"
        aria-label="Main navigation"
      >
        <ul class="m-0 flex list-none items-center gap-1">
          {navItems.map((item) => (
            <li data-site-nav-item class="relative">
              <a
                href={item.href}
                class="site-header-nav-link min-h-12 rounded-full px-4 py-2.5 font-body text-sm font-medium text-neutral-700 no-underline transition-[color,transform] duration-[var(--transition-fast)] hover:-translate-y-px hover:text-primary-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
                aria-haspopup={item.groups ? "true" : undefined}
                aria-current={isActiveSiteNavItem(currentPath, item, navItems) ? "page" : undefined}
              >
                {item.label}
              </a>
              {item.groups && item.groups.length > 0 && (
                <div
                  data-site-nav-group
                  class="site-header-megamenu invisible absolute left-0 top-full z-50 translate-y-1 pt-2 opacity-0 transition-[opacity,transform,visibility] duration-[var(--transition-fast)]"
                >
                  <nav
                    class="site-header-megamenu-panel w-[34rem] max-w-[calc(100vw-2rem)] rounded-lg border border-[var(--gp-ink-200)] bg-[var(--gp-card)] p-4 shadow-lg"
                    aria-label={`${item.label} menu`}
                  >
                    <div class="[column-count:2] [column-gap:1.25rem]">
                      {item.groups.map((navGroup) => (
                        <section class="mb-4 break-inside-avoid last:mb-0">
                          <p class="px-3 font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-muted">
                            {navGroup.heading}
                          </p>
                          <div class="mt-1.5 grid gap-0.5">
                            {navGroup.links.map((link) => (
                              <a
                                href={link.href}
                                class="group min-w-0 rounded-full px-3 py-2 no-underline transition-[background-color,color] duration-[var(--transition-fast)] hover:bg-[var(--gp-paper-2)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
                              >
                                <span class="block text-sm font-semibold text-brand-text group-hover:text-primary-700">
                                  {link.label}
                                </span>
                                {link.description && (
                                  <span class="mt-0.5 block text-xs leading-snug text-brand-muted">
                                    {link.description}
                                  </span>
                                )}
                              </a>
                            ))}
                          </div>
                        </section>
                      ))}
                    </div>
                    <a
                      href={item.href}
                      data-megamenu-footer-link
                      class="mt-2 flex items-center justify-between rounded-full border-t border-[var(--gp-ink-100)] px-3 pb-1 pt-3 text-sm font-semibold text-primary-700 no-underline transition-colors hover:text-primary-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
                    >
                      <span>Browse all {item.label.toLowerCase()}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </nav>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="site-header-actions flex items-center gap-3">
        <slot name="search" />

        {loginHref && (
          <a
            href={loginHref}
            class="hidden min-h-12 items-center rounded-full px-3.5 text-sm font-medium text-foreground/70 no-underline transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)] lg:inline-flex"
          >
            Sign in
          </a>
        )}

        <div class="hidden lg:flex">
          <a
            href={ctaHref}
            class:list={[
              ctaButtonClass,
              "shrink-0 whitespace-nowrap no-underline",
            ]}
          >
            {ctaText}
          </a>
        </div>

        <div class="relative lg:hidden" id="mobile-nav-details">
          <noscript>
            <div
              data-mobile-nav-fallback
              class="mobile-nav-fallback mt-3 w-[min(22rem,calc(100vw-1rem))] overflow-hidden rounded-lg border border-[var(--gp-ink-200)] bg-[var(--gp-card)] shadow-lg"
            >
              <nav class="flex flex-col p-3" aria-label="Mobile navigation fallback">
                <p class="px-3 py-2 text-[length:var(--text-body-sm)] font-medium text-brand-muted">
                  Menu
                </p>
                {navItems.map((item) => (
                  <>
                    <a
                      href={item.href}
                      class="flex min-h-[48px] items-center rounded-full px-4 py-3 font-body text-[length:var(--text-body)] text-neutral-700 no-underline transition-[background-color,color,transform] duration-[var(--transition-fast)] hover:translate-x-0.5 hover:bg-[var(--gp-emerald-50)] hover:text-primary-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
                      aria-current={isActiveSiteNavItem(currentPath, item, navItems) ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                    {item.groups?.map((navGroup) => (
                      <div data-mobile-nav-group class="px-4 pb-2">
                        <p class="pt-2 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-brand-muted">
                          {navGroup.heading}
                        </p>
                        <div class="mt-1 grid gap-1">
                          {getMobileNavLinks(navGroup).map((link) => (
                            <a
                              href={link.href}
                              class="flex min-h-[48px] items-center rounded-full py-2 pl-3 pr-2 text-sm font-medium text-neutral-700 no-underline transition-colors hover:bg-[var(--gp-emerald-50)] hover:text-primary-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
                            >
                              {link.label}
                            </a>
                          ))}
                        </div>
                      </div>
                    ))}
                  </>
                ))}
                <div class="mt-3 rounded-md border border-[var(--gp-ink-200)] bg-[var(--gp-paper-2)] px-4 pb-4 pt-3">
                  <p class="mb-2 text-[length:var(--text-body-sm)] font-medium text-brand-muted">
                    {mobileCtaEyebrow}
                  </p>
                  <a
                    href={ctaHref}
                    class:list={[
                      ctaButtonClass,
                      "flex !min-h-[48px] w-full items-center justify-center text-center no-underline",
                    ]}
                  >
                    {ctaText}
                  </a>
                  {loginHref && (
                    <a
                      href={loginHref}
                      class="mt-2 flex min-h-[48px] w-full items-center justify-center rounded-full py-2 text-center text-sm font-medium text-neutral-600 no-underline transition-colors hover:text-neutral-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
                    >
                      Sign in
                    </a>
                  )}
                </div>
              </nav>
            </div>
          </noscript>

          <button
            type="button"
            data-mobile-nav-trigger
            aria-label="Toggle navigation menu"
            aria-controls="mobile-nav-panel"
            aria-expanded="false"
            class="mobile-nav-trigger relative z-[61] min-h-12 min-w-12 cursor-pointer items-center justify-center rounded-full border border-[var(--gp-ink-200)] bg-[var(--gp-card)] p-2 text-neutral-600 shadow-sm transition-[background-color,border-color,color,transform] duration-[var(--transition-fast)] hover:-translate-y-px hover:border-[var(--gp-emerald-100)] hover:bg-[var(--gp-paper)] hover:text-primary-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
          >
            <svg
              class="hamburger-icon h-5 w-5"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg
              class="close-icon hidden h-5 w-5"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>

          <div data-mobile-nav-overlay class="mobile-nav-overlay" hidden>
            <div class="mobile-nav-backdrop" data-mobile-nav-backdrop aria-hidden="true"></div>

            <div class="mobile-nav-panel-shell overflow-hidden rounded-lg border border-[var(--gp-ink-200)] bg-[var(--gp-card)] shadow-lg">
              <nav
                id="mobile-nav-panel"
                class="relative flex flex-col p-3 pt-14"
                aria-label="Mobile navigation"
              >
                <p class="px-3 py-2 text-[length:var(--text-body-sm)] font-medium text-brand-muted">
                  Menu
                </p>
                {navItems.map((item) => (
                  <>
                    <a
                      href={item.href}
                      class="flex min-h-[48px] items-center rounded-full px-4 py-3 font-body text-[length:var(--text-body)] text-neutral-700 no-underline transition-[background-color,color,transform] duration-[var(--transition-fast)] hover:translate-x-0.5 hover:bg-[var(--gp-emerald-50)] hover:text-primary-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
                      aria-current={isActiveSiteNavItem(currentPath, item, navItems) ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                    {item.groups?.map((navGroup) => (
                      <div data-mobile-nav-group class="px-4 pb-2">
                        <p class="pt-2 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-brand-muted">
                          {navGroup.heading}
                        </p>
                        <div class="mt-1 grid gap-1">
                          {getMobileNavLinks(navGroup).map((link) => (
                            <a
                              href={link.href}
                              class="flex min-h-[48px] items-center rounded-full py-2 pl-3 pr-2 text-sm font-medium text-neutral-700 no-underline transition-colors hover:bg-[var(--gp-emerald-50)] hover:text-primary-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
                            >
                              {link.label}
                            </a>
                          ))}
                        </div>
                      </div>
                    ))}
                  </>
                ))}
                <div class="mt-3 rounded-md border border-[var(--gp-ink-200)] bg-[var(--gp-paper-2)] px-4 pb-4 pt-3">
                  <p class="mb-2 text-[length:var(--text-body-sm)] font-medium text-brand-muted">
                    {mobileCtaEyebrow}
                  </p>
                  <a
                    href={ctaHref}
                    class:list={[
                      ctaButtonClass,
                      "flex !min-h-[48px] w-full items-center justify-center text-center no-underline",
                    ]}
                  >
                    {ctaText}
                  </a>
                  {loginHref && (
                    <a
                      href={loginHref}
                      class="mt-2 flex min-h-[48px] w-full items-center justify-center rounded-full py-2 text-center text-sm font-medium text-neutral-600 no-underline transition-colors hover:text-neutral-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--gp-emerald-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--gp-paper)]"
                    >
                      Sign in
                    </a>
                  )}
                </div>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
</div>

<style>
  .mobile-nav-overlay {
    margin-top: 0.5rem;
  }

  .mobile-nav-trigger {
    display: none;
  }

  .mobile-nav-backdrop {
    display: none;
  }

  .mobile-nav-panel-shell {
    width: min(22rem, calc(100vw - 1rem));
    margin-left: auto;
  }

  [data-mobile-nav-ready="true"] .mobile-nav-trigger {
    display: inline-flex;
  }

  [data-mobile-nav-ready="true"] [data-mobile-nav-fallback] {
    display: none;
  }

  [data-mobile-nav-ready="true"] .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 58;
    margin-top: 0;
  }

  [data-mobile-nav-ready="true"] .mobile-nav-overlay[hidden] {
    display: none;
  }

  [data-mobile-nav-ready="true"] .mobile-nav-backdrop {
    display: block;
    position: absolute;
    inset: 0;
    /* Scrim intentionally uses --surface-overlay color-mix: no semantic --gp-* alpha token exists for the dim overlay. */
    background: color-mix(in srgb, var(--surface-overlay) 72%, transparent);
  }

  [data-mobile-nav-ready="true"] .mobile-nav-panel-shell {
    position: absolute;
    right: 0.5rem;
    top: calc(4.5rem + 1rem);
    z-index: 60;
    margin-left: 0;
  }

  [data-mobile-nav-trigger][aria-expanded="true"] .hamburger-icon {
    display: none;
  }

  [data-mobile-nav-trigger][aria-expanded="true"] .close-icon {
    display: block;
  }

  #site-header {
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  #site-header.is-scrolled {
    border-bottom-color: var(--gp-ink-300, var(--gp-ink-200));
    box-shadow: 0 1px 0 0 var(--gp-ink-200), 0 6px 16px -12px rgb(0 0 0 / 0.18);
  }

  #site-header.is-scrolled [data-site-header-inner] {
    background-color: var(--gp-paper);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header {
      transition-duration: 0.01ms;
    }
  }

  [data-site-nav-item]:hover [data-site-nav-group],
  [data-site-nav-item]:focus-within [data-site-nav-group] {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  import { initMobileNav } from "../lib/mobile-nav"

  const SCROLL_THRESHOLD = 12

  let cleanupScrollShadow = () => {}
  let cleanupMobileNav = () => {}
  let cleanupBeforeSwap = () => {}

  function initScrollShadow(header: HTMLElement) {
    if (header.dataset.scrollShadowBound === "true") return () => {}
    header.dataset.scrollShadowBound = "true"

    let ticking = false
    function syncScrollState() {
      if (window.scrollY > SCROLL_THRESHOLD) {
        header.classList.add("is-scrolled")
      } else {
        header.classList.remove("is-scrolled")
      }
    }
    function handleScroll() {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        syncScrollState()
        ticking = false
      })
    }

    window.addEventListener("scroll", handleScroll, { passive: true })
    syncScrollState()

    return () => {
      window.removeEventListener("scroll", handleScroll)
      delete header.dataset.scrollShadowBound
    }
  }

  function init() {
    cleanupScrollShadow()
    cleanupMobileNav()

    const header = document.getElementById("site-header")
    cleanupScrollShadow = header ? initScrollShadow(header) : () => {}

    const mobileNavRoot = document.getElementById("mobile-nav-details")
    if (mobileNavRoot instanceof HTMLElement) {
      mobileNavRoot.dataset.mobileNavReady = "true"
      cleanupMobileNav = initMobileNav(mobileNavRoot)
    } else {
      cleanupMobileNav = () => {}
    }
  }

  init()
  document.addEventListener("astro:page-load", init)

  cleanupBeforeSwap = () => {
    cleanupScrollShadow()
    cleanupMobileNav()
  }
  document.addEventListener("astro:before-swap", cleanupBeforeSwap)
</script>
