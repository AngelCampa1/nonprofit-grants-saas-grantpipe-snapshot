---
import { getPublicApiBaseUrl } from "../lib/public-api-url"
import type {
  SiteConfig,
  CategorySummary,
  BreadcrumbItem,
  FaqItem,
  LeadMagnetOffer,
} from "../types"
import { sumCategoryCounts } from "../lib/collections"
import { hasHubFaqs, normalizeHubCanonicalUrl } from "../lib/hub-utils"
import { buildCollectionPageSchema } from "../lib/schema-builders"
import { buildGraph, withId } from "../lib/schema-graph"
import BaseLayout from "../layouts/base-layout.astro"
import SiteHeader from "../components/site-header.astro"
import SiteFooter from "../components/site-footer.astro"
import BreadcrumbNav from "../components/breadcrumb-nav.astro"
import FaqSection from "../components/faq-section.astro"
import SchemaMarkup from "../seo/schema-markup.astro"
import { ExitIntentPopup } from "../components/exit-intent-popup"
import { resolveExitPopupProps } from "../lib/exit-popup-props"

interface Props {
  config: SiteConfig
  title: string
  description: string
  categories: CategorySummary[]
  canonicalUrl: string
  breadcrumbs: BreadcrumbItem[]
  browseLinkText?: string
  itemNoun?: string
  categoryNoun?: string
  categoryNounPlural?: string
  faqs?: FaqItem[]
  faqHeading?: string
  eyebrow?: string
  variant?: "default" | "editorial"
  leadMagnet?: LeadMagnetOffer
  /** Whether to render the sticky mobile CTA bar on this page. */
  showStickyMobileCta?: boolean
  /** CTA button label for the sticky mobile bar. Defaults to the config funnel bofu CTA text. */
  stickyCtaText?: string
  /** CTA button href for the sticky mobile bar. Defaults to the config funnel bofu CTA target. */
  stickyCtaTarget?: string
}

const {
  config,
  title,
  description,
  categories = [],
  canonicalUrl,
  breadcrumbs,
  browseLinkText = "Browse ->",
  itemNoun = "article",
  categoryNoun = "category",
  categoryNounPlural = "categories",
  faqs = [],
  faqHeading,
  eyebrow,
  variant = "default",
  leadMagnet,
  showStickyMobileCta = false,
  stickyCtaText,
  stickyCtaTarget,
} = Astro.props

const totalItems = sumCategoryCounts(categories)
const siteUrl = `https://${config.domain}`
const normalizedCanonicalUrl = normalizeHubCanonicalUrl(canonicalUrl)
const collectionSchema = buildCollectionPageSchema({
  name: title,
  description,
  url: normalizedCanonicalUrl,
  items: categories.map(cat => ({
    name: cat.name,
    description: cat.description,
    url: `${siteUrl}${cat.href}`,
  })),
})
const graph = buildGraph([withId(collectionSchema, `${normalizedCanonicalUrl}#collection`)])
const exitPopupProps = config.exitPopup?.enabled !== false ? resolveExitPopupProps(config) : undefined
const publicApiUrl = getPublicApiBaseUrl()

---

<BaseLayout
  title={`${title} | ${config.name}`}
  description={description}
  canonicalUrl={normalizedCanonicalUrl}
  siteName={config.name}
  ogType="website"
  themeColor={config.theme.primary}
  theme={config.theme}
  fonts={config.theme.fonts}
  appleTouchIcon={config.appleTouchIcon}
  showStickyMobileCta={showStickyMobileCta}
  stickyCtaText={stickyCtaText ?? config.funnel.bofu.ctaText}
  stickyCtaTarget={stickyCtaTarget ?? config.funnel.bofu.ctaTarget}
>
  <SiteHeader
    slot="header"
    siteName={config.name}
    navItems={config.nav?.items}
    ctaText={config.funnel.bofu.ctaText}
    ctaHref={config.funnel.bofu.ctaTarget}
    loginHref={config.appLoginUrl}
    logoLight={config.logo?.light}
    currentPath={Astro.url.pathname}
  />

  <div
    data-hub-layout
    class:list={[
      "hub-shell mx-auto px-4 py-[var(--section-py-sm)]",
      variant === "editorial" ? "max-w-6xl editorial-shell" : "max-w-5xl",
    ]}
  >
    <BreadcrumbNav items={breadcrumbs} siteUrl={`https://${config.domain}`} />

    <header
      data-hub-hero
      class:list={[
        "hub-intro mt-4",
        variant === "editorial"
          ? "mb-12 grid gap-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(16rem,0.6fr)] lg:items-end"
          : "mb-10 rounded-xl border border-neutral-200 bg-surface-secondary px-6 py-7 shadow-card",
      ]}
    >
      <div class="max-w-[var(--content-measure-wide)]">
        {eyebrow && variant === "editorial" && <p class="gp-kicker--accent">{eyebrow}</p>}
        <h1
          class:list={[
            "font-heading font-bold text-brand-text",
            variant === "editorial"
              ? "mt-4 text-[length:var(--text-editorial-title)] leading-[1.04]"
              : "mb-3 text-[length:var(--text-heading)]",
          ]}
        >
          {title}
        </h1>
        <p
          class:list={[
            "text-brand-muted",
            variant === "editorial"
              ? "editorial-lede"
              : "max-w-2xl text-[length:var(--text-body-lg)]",
          ]}
        >
          {description}
        </p>
      </div>

      <div
        class:list={[
          variant === "editorial"
            ? "editorial-panel editorial-panel--soft p-5 lg:justify-self-end lg:max-w-[18rem]"
            : "mt-3 inline-flex rounded-full bg-surface-elevated px-3 py-1 text-[length:var(--text-caption)] text-neutral-500",
        ]}
      >
        <p class="text-[length:var(--text-caption)] text-neutral-500">
          {totalItems} {totalItems === 1 ? itemNoun : `${itemNoun}s`} across {categories.length} {categories.length === 1 ? categoryNoun : categoryNounPlural}
        </p>
      </div>
    </header>

    <section aria-label={`Content ${categories.length === 1 ? categoryNoun : categoryNounPlural}`}>
      <div data-hub-card-grid class="hub-grid grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((category) => (
            <a
              href={category.href}
              data-hub-card
              class:list={[
                "group block rounded-lg border transition-[transform,box-shadow,border-color,background-color] duration-[var(--transition-base)] scroll-in",
                variant === "editorial"
                  ? "editorial-panel p-6 md:p-7 hover:-translate-y-0.5"
                  : "border-neutral-200 bg-surface-elevated p-6 shadow-card hover:-translate-y-0.5 hover:border-primary-200 hover:bg-surface-primary",
              ]}
            >
              <div class="mb-3 flex items-start justify-between gap-3">
                <h2
                  class:list={[
                    "font-heading font-bold text-brand-text transition-colors",
                    variant === "editorial"
                      ? "text-[length:var(--text-subheading)] leading-tight"
                      : "text-[length:var(--text-body-lg)] group-hover:text-brand-primary",
                  ]}
                >
                  {category.name}
                </h2>
                <span
                  class:list={[
                    "shrink-0 px-2.5 py-1 text-[length:var(--text-caption)] font-mono",
                    variant === "editorial"
                      ? "rounded bg-primary-50 text-primary-700"
                      : "rounded-full bg-surface-secondary text-neutral-500",
                  ]}
                >
                  {category.count}
                </span>
              </div>
              <p
                class:list={[
                  "leading-relaxed text-brand-muted",
                  variant === "editorial"
                    ? "mt-4 text-[length:var(--text-body)]"
                    : "mt-2 text-[length:var(--text-caption)]",
                ]}
              >
                {category.description}
              </p>
              <span
                class:list={[
                  "inline-flex items-center gap-1 text-[length:var(--text-caption)] font-medium text-brand-primary",
                  variant === "editorial" ? "mt-5 editorial-link" : "mt-4",
                ]}
                aria-hidden="true"
              >
                {browseLinkText.replace(/->$/, "").trimEnd()}
                {browseLinkText.includes("->") && (
                  <span class="inline-block transition-transform duration-[var(--transition-fast)] group-hover:translate-x-1">-&gt;</span>
                )}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <slot name="extra" />
    <slot name="cta" />

    {hasHubFaqs(faqs) && (
      <FaqSection
        faqs={faqs}
        heading={faqHeading}
        showBottomCta={false}
        ctaVariant="compact"
      />
    )}
  </div>

  <SiteFooter
    slot="footer"
    siteName={config.name}
    tagline={config.tagline}
    linkGroups={config.footer?.linkGroups}
    legalLinks={config.footer?.legalLinks}
    logoLight={config.logo?.light}
    captureVariant="compact"
  />
  <SchemaMarkup graph={graph} />
  {exitPopupProps && (
    <ExitIntentPopup
      client:load
      apiUrl={publicApiUrl}
      leadMagnet={leadMagnet}
      {...exitPopupProps}
    />
  )}
</BaseLayout>
