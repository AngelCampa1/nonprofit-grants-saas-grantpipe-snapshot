---
interface Props {
  text: string
  label?: string
}
const { text, label = "Short answer" } = Astro.props
---

<div class="bluf-block rounded-l-none rounded-r-lg border-l-4 border-accent-500 bg-accent-50 px-7 py-5 mb-8" role="note">
  <p class="font-mono text-[length:var(--text-caption)] uppercase tracking-widest text-accent-700 mb-1.5">{label}</p>
  <p class="text-[length:var(--text-body-lg)] font-medium leading-relaxed text-brand-text">{text}</p>
</div>
